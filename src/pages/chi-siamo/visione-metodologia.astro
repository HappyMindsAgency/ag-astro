---
import Layout from '../../components/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ImageOverview from '../../components/ImageOverview.astro';
import CallToAction from '../../components/CallToAction.astro';
import ServiceOverview from '../../components/ServiceOverview.astro';
import '../../styles/pages/visione-e-metodologia.scss';

const services = [
  { title: 'Competenza', description: 'Uniamo conoscenze specialistiche, esperienza e aggiornamento continuo per affrontare ogni incarico con consapevolezza.' },
  { title: 'Fiducia', description: 'Costruiamo relazioni fondate sull’ascolto, sulla chiarezza e sulla riservatezza. La fiducia nasce nel tempo e si mantiene attraverso comportamenti coerenti.' },
  { title: 'Responsabilità', description: 'Assumere un incarico significa rispondere delle decisioni adottate e amministrare i beni nel rispetto dell’atto istitutivo, delle finalità del trust e degli interessi coinvolti.' },
  { title: 'Continuità', description: 'Accompagniamo il trust durante il suo intero ciclo di vita, mantenendo una presenza stabile e una visione capace di collegare presente e futuro.' },
  { title: 'Equilibrio', description: 'Valutiamo ogni decisione considerando le persone, le relazioni, il patrimonio e le finalità da perseguire.' },
];

const methodIntroduction = 'Ogni incarico segue un percorso costruito sulle esigenze delle persone e le finalità del trust.';

const methodSteps = [
  { title: 'Comprendere', description: 'Ascoltiamo le persone e analizziamo il contesto: gli obiettivi, la composizione del patrimonio, le relazioni coinvolte e le finalità da perseguire.' },
  { title: 'Definire', description: 'Vengono definiti ruoli, responsabilità, poteri, processi decisionali e modalità di amministrazione, nel rispetto della normativa e delle finalità individuate.' },
  { title: 'Amministrare', description: 'Diamo attuazione alle disposizioni dell’atto istitutivo, amministriamo i beni conferiti e curiamo gli adempimenti contabili, fiscali e amministrativi connessi all’incarico.' },
  { title: 'Accompagnare', description: 'Il trust evolve insieme alle persone, ai beni e alle circostanze. Manteniamo una relazione continuativa con beneficiari, guardiani, consulenti e altri soggetti coinvolti, accompagnando il progetto nel tempo.' },
];
---

<Layout>
  <PageIntro titleAccent="metodologia" breadcrumb="Visione e metodologia" parents={[{ label: 'Chi siamo', href: '/chi-siamo/' }]} eyebrow="Una visione di lungo periodo, un metodo fondato sulla responsabilità" mobileTitleLeading="relaxed" wideTitle>
    <Fragment slot="title">Visione e</Fragment>
    Il metodo di AG Trustees nasce dall'incontro tra competenze consolidate e da un'idea comune di responsabilità fiduciaria vicina alle persone.
  </PageIntro>

  <ImageOverview
    id="vision"
    class="vision-overview"
    eyebrow="La nostra visione"
    image={{ src: '/assets/immagini/visione/ag-trustees-visione-responsabilita-fiduciaria.jpg', alt: 'Due professionisti negli uffici di AG Trustees', width: 1170, height: 780 }}
  >
    <Fragment slot="title">Ogni incarico comincia <span class="type-section-title-accent d-block">dall’ascolto</span></Fragment>
    Per noi un patrimonio non è soltanto un insieme di beni. È una storia fatta di persone, legami, lavoro, decisioni e progetti destinati a proseguire nel tempo.
  </ImageOverview>

  <ServiceOverview id="services" services={services} eyebrow="I principi che ci guidano" title="I valori che orientano ogni incarico" backgroundImage="/assets/immagini/visione/ag-trustees-servizi-professionali.jpg" />

  <section class="vision-method section-spacing" aria-labelledby="vision-method-title">
    <div class="container section-container px-lg-0">
      <div class="row gx-4 gy-4 align-items-center">
        <div class="col-xxl-7">
          <p class="type-eyebrow type-eyebrow--section vision-eyebrow">Il nostro metodo</p>
          <h2 id="vision-method-title" class="type-section-title mb-0">
            Dall’ascolto <span class="type-section-title-accent d-xxl-block">all’amministrazione.</span>
          </h2>
        </div>
        <div class="col-xxl-5">
          <p class="vision-editorial-copy vision-method-introduction mb-0">{methodIntroduction}</p>
        </div>
      </div>
      <ol class="row g-0 vision-method-steps list-unstyled mb-0">
        {methodSteps.map((step, index) => (
          <li class="col-12 col-lg-6 col-xxl-3 vision-method-step">
            <p class="vision-method-index mb-0" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
            <h3>{step.title}</h3>
            <p class="vision-method-copy mb-0">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CallToAction
    eyebrow="AG Trustees — Esperti in trust e pianificazione patrimoniale"
    href="/servizi/"
    label="Scopri i nostri servizi"
    secondaryAction={{ label: 'Richiedi un confronto', href: '/contatti/' }}
  >
    <Fragment slot="title">La continuità nasce da un progetto amministrato con responsabilità</Fragment>
    Ogni incarico richiede ascolto, competenza e una presenza capace di durare nel tempo.
  </CallToAction>
</Layout>
