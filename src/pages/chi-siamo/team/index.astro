---
import type { TeamMember } from '../../../types/content';
import { getTeamByRuolo, type Ruolo } from '../../../lib/team';
import Layout from '../../../components/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import TeamMemberCard from '../../../components/TeamMemberCard.astro';
import ContactSection from '../../../components/ContactSection.astro';
import NewsletterCallToAction from '../../../components/NewsletterCallToAction.astro';
import '../../../styles/pages/team.scss';

interface TeamSection {
  id: Ruolo;
  eyebrow: string;
  title: string;
  accent: string;
  members: TeamMember[];
}

const team = await getTeamByRuolo('it-IT');

const sections: TeamSection[] = [
  { id: 'Direttivo', eyebrow: 'Leadership', title: 'Guidare la crescita', accent: 'della società', members: team.Direttivo },
  { id: 'Operativo', eyebrow: 'Team', title: 'Gestire l’operatività', accent: 'di ogni incarico', members: team.Operativo },
  { id: 'Consulente', eyebrow: 'Of counsel', title: 'Affiancare le decisioni', accent: 'più complesse', members: team.Consulente },
];
---

<Layout>
  <PageIntro breadcrumb="Team" parents={[{ label: 'Chi siamo', href: '/chi-siamo/' }]} eyebrow="La fiducia comincia dalle persone.">
    <Fragment slot="title"><span class="d-block">Il nostro</span>{' '}<span class="d-block text-secondary">team.</span></Fragment>
    Competenze diverse, una responsabilità condivisa: accompagnare ogni incarico con ascolto, rigore e continuità.
  </PageIntro>

  {sections.filter(({ members }) => members.length > 0).map(({ id, eyebrow, title, accent, members }) => (
    <section class:list={['team-section section-spacing', `team-section--${id}`]} aria-labelledby={`team-${id}-title`}>
      {id === 'Operativo' && <img class="team-section-mark d-none d-lg-block" src="/assets/brand/ag-logo-verticale-nero.png" width="1200" height="1145" alt="" aria-hidden="true" loading="lazy" />}
      <div class:list={['container section-container', { 'px-0': id === 'Direttivo' }]}>
        <div class="row gx-4 gy-4 align-items-end team-section-header">
          <div class="col-12">
            <p class="type-eyebrow type-eyebrow--section team-section-eyebrow">{eyebrow}</p>
            <h2 id={`team-${id}-title`} class="type-section-title mb-0">{title}{' '}<span class="type-section-title-accent team-section-title-accent d-lg-block">{accent}</span></h2>
          </div>
        </div>
        <div class:list={[
          'row team-members',
          {
            'gx-0 gy-4 gy-xxl-0 row-cols-1 row-cols-xxl-3 justify-content-center': id === 'Direttivo',
            'gx-0 gy-4 row-cols-1 row-cols-xl-2': id === 'Operativo',
            'g-3 g-lg-4 row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xxl-5': id === 'Consulente',
          },
        ]}>
          {members.map((member) => <div class="col"><TeamMemberCard member={member} variant={id} /></div>)}
        </div>
      </div>
    </section>
  ))}

  <ContactSection eyebrow="Contattaci" />

  <NewsletterCallToAction contained={false} />
</Layout>
