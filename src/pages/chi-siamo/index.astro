---
import Layout from '../../components/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CompanyHistory from '../../components/CompanyHistory.astro';
import Certifications from '../../components/Certifications.astro';
import ContactSection from '../../components/ContactSection.astro';
import '../../styles/pages/chi-siamo.scss';

const identityCards = [
  {
    title: 'Ambiti',
    description: 'Progetti dedicati alla continuità d’impresa, al passaggio generazionale, alla tutela delle persone e alla gestione di patrimoni complessi.',
  },
  {
    title: 'Ruolo',
    description: 'AG Trustees opera come trustee, co-trustee o guardiano, amministrando i beni e per il realizzo delle finalità del trust.',
  },
];

const historySteps = [
  {
    title: 'Le origini',
    description: 'Argos Trustees e Galvani Fiduciaria condividono un\'esperienza pluriennale nello svolgimento dell\'attività di trustee professionale. Le due realtà condividono lo stesso modo di intendere la responsabilità fiduciaria: dietro ogni patrimonio ci sono persone, legami e progetti che devono essere accompagnati nel tempo.',
  },
  {
    title: 'L’incontro',
    description: 'Nel 2025, preso atto dell\'uniformità di intenti e delle reciproche competenze ed esperienze, prende forma il progetto di aggregazione tra le due realtà.',
  },
  {
    title: 'Nasce AG Trustees',
    description: 'Nasce una nuova società dedicata all’attività di trustee, con un’identità autonoma e un patrimonio di esperienze già consolidato, operativa dal 1 gennaio 2026.',
  },
  {
    title: 'Il futuro',
    description: 'AG Trustees con la propria competenza accompagna i propri clienti nella realizzazione dei progetti di lungo periodo, costruendo relazioni capaci di garantire stabilità e continuità tra generazioni.',
  },
];

const methodSteps = [
  {
    title: 'Ascoltare',
    description: 'Partiamo dalle persone, dalle loro esigenze e dal contesto in cui nasce il progetto.',
    icon: '/assets/icone/metodo-ascoltare.svg',
  },
  {
    title: 'Comprendere',
    description: 'Analizziamo gli obiettivi, la composizione del patrimonio, le relazioni e le finalità da perseguire.',
    icon: '/assets/icone/metodo-comprendere.svg',
  },
  {
    title: 'Definire',
    description: 'Costruiamo insieme ai professionisti coinvolti una struttura chiara, coerente e sostenibile nel tempo.',
    icon: '/assets/icone/metodo-definire.svg',
  },
  {
    title: 'Amministrare e accompagnare',
    description: 'Gestiamo il progetto con precisione, documentiamo le decisioni e manteniamo una relazione continuativa con tutti i soggetti coinvolti.',
    icon: '/assets/icone/metodo-amministrare.svg',
  },
];
---

<Layout>
  <PageIntro titleAccent="siamo"
    breadcrumb="Chi siamo"
    eyebrow="Amministriamo il presente con una visione condivisa del futuro"
    mobileTitleLeading="tight"
  >
    <Fragment slot="title">Chi</Fragment>
    AG Trustees è una trust company dedicata all’amministrazione professionale di trust. Mettiamo competenze ed esperienza al servizio di persone, famiglie e imprese, accompagnando nel tempo patrimoni, progetti e persone. Le nostre sedi sono a Milano, Bologna e Forlì.
  </PageIntro>

  <section class="about-identity section-spacing" aria-labelledby="identity-title">
    <div class="container section-container px-lg-0">
      <div class="row gx-4">
        <div class="col-lg-5">
          <p class="type-eyebrow about-identity-eyebrow mb-lg-0">Chi è AG Trustees</p>
        </div>
        <div class="col-lg-7">
          <h2 id="identity-title" class="type-section-title about-identity-title">
            Una trust company <span class="d-block">italiana</span>
          </h2>
          <p class="type-section-copy about-identity-copy mb-0">Affianchiamo famiglie, imprenditori e professionisti nell’istituzione e nell’amministrazione di trust, con competenza giuridica, equilibrio e visione di lungo periodo.<br />Perché dietro ogni patrimonio ci sono legami, imprese, responsabilità e progetti che cambiano ed evolvono nel tempo.<br />AG Trustees amministra i beni conferiti in trust, cura gli adempimenti connessi e lavora insieme ai professionisti coinvolti.</p>
        </div>
      </div>
      <div class="row gx-0 about-identity-cards">
        {identityCards.map((card, index) => (
          <article class="col-6 about-identity-card">
            <p class="about-identity-index mb-0" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
            <h3>{card.title}</h3>
            <p class="about-identity-card-copy mb-0">{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="about-video" hidden aria-hidden="true">
    <div class="about-video-space"></div>
  </div>

  <section class="about-origin section-spacing" aria-labelledby="origin-title">
    <div class="container section-container px-lg-0">
      <div class="row gx-4 align-items-end">
        <div class="col-lg-7">
          <p class="type-eyebrow type-eyebrow--section about-origin-eyebrow">Come nasce AG Trustees</p>
          <h2 id="origin-title" class="type-section-title type-section-title--compact about-origin-title mb-0">
            <span class="about-origin-title-line">Due storie professionali,</span>{' '}
            <span class="about-origin-title-line">una nuova idea di</span>{' '}
            <span class="type-section-title-accent">responsabilità</span>.
          </h2>
        </div>
        <div class="col-lg-5">
          <p class="type-section-lead about-origin-copy mb-0">AG Trustees nasce dall’unione delle competenze di Argos Trustees e Galvani Fiduciaria, due realtà con una lunga esperienza nell’attività di trustee e nella gestione patrimoniale. Ogni attività è guidata da ascolto, chiarezza, competenza e responsabilità.</p>
        </div>
      </div>
    </div>
  </section>

  <CompanyHistory steps={historySteps} />

  <section class="about-competencies section-spacing" aria-labelledby="competencies-title">
    <div class="container section-container px-lg-0">
      <div class="row gx-4 align-items-end justify-content-between about-competencies-heading">
        <div class="col-lg-7">
          <p class="type-eyebrow type-eyebrow--section about-competencies-eyebrow">Le nostre competenze</p>
          <h2 id="competencies-title" class="type-section-title type-section-title--compact mb-0">
            Conoscenze diverse per <span class="type-section-title-accent">amministrare</span> progetti complessi.
          </h2>
        </div>
        <div class="col-lg-5">
          <p class="type-section-lead about-competencies-copy mb-0">La gestione di un trust richiede capacità di gestire aspetti giuridici, fiscali, patrimoniali e relazionali nel loro insieme. Gestione amministrativa, contabile e fiscale, organizzazione della documentazione, rendicontazione e coordinamento con i professionisti coinvolti.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-method section-spacing" aria-labelledby="method-title">
    <div class="container section-container px-lg-0">
      <div class="about-method-heading text-center mx-auto">
        <p class="type-eyebrow type-eyebrow--section">Il nostro approccio</p>
        <h2 id="method-title" class="type-section-title mb-0">Il metodo è parte <span class="d-block">della <span class="text-secondary">responsabilità.</span></span></h2>
      </div>
      <ol class="row g-0 about-method-cards list-unstyled mb-0">
        {methodSteps.map((step, index) => (
          <li class="col-6 col-xxl-3 about-method-card">
            <div class="d-flex align-items-center justify-content-between">
              <img class="about-method-icon" src={step.icon} alt="" width="24" height="24" loading="lazy" />
              <span class="about-method-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3>{step.title}</h3>
            <p class="about-method-copy mb-0">{step.description}</p>
          </li>
        ))}
      </ol>
      <div class="text-center mt-4">
        <a class="btn site-button site-button--light" href="/chi-siamo/visione-metodologia/">Scopri la nostra visione <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="about-team section-spacing" aria-labelledby="team-title">
    <img class="about-team-mark" src="/assets/brand/ag-logo-verticale-nero.png" alt="" width="1200" height="1145" loading="lazy" />
    <div class="container section-container px-lg-0 position-relative">
      <div class="row">
        <div class="col-lg-9 col-xxl-7">
          <p class="type-eyebrow type-eyebrow--section about-team-eyebrow">Team</p>
          <h2 id="team-title" class="about-team-title">La fiducia comincia <span class="d-block">dalle persone.</span></h2>
          <p class="type-section-lead about-team-copy">Scopri le professionalità che ogni giorno amministrano gli incarichi di AG Trustees con competenza, responsabilità e continuità.</p>
          <a class="btn site-button about-team-link" href="/chi-siamo/team/">Conosci il team <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <Certifications />
  <ContactSection eyebrow="Contattaci" />
</Layout>
