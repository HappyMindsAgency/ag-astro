---
import Layout from '../../components/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import LibraryArchive from '../../components/LibraryArchive.astro';
import NewsletterCallToAction from '../../components/NewsletterCallToAction.astro';
import { libraryDocumentPlaceholders, libraryCategories } from '../../data/library-placeholders';
import '../../styles/pages/knowledge-library.scss';
---

<Layout>
  <div class="library-page">
    <PageIntro breadcrumb="Knowledge Library" eyebrow="Archivio di documenti e materiali" wideTitle>
      <Fragment slot="title"><span class="d-block">Knowledge</span>{' '}<span class="d-block text-secondary">Library.</span></Fragment>
      Consulta un patrimonio documentale selezionato e organizzato da AG Trustees per agevolare la consultazione e l’approfondimento.
    </PageIntro>

    <LibraryArchive documents={libraryDocumentPlaceholders} categories={libraryCategories} />

    <NewsletterCallToAction plainBackground />
  </div>
</Layout>
