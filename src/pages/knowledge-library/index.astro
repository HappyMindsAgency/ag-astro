---
import Layout from '../../components/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import LibraryArchive from '../../components/LibraryArchive.astro';
import CallToAction from '../../components/CallToAction.astro';
import { libraryDocumentPlaceholders, libraryCategories } from '../../data/library-placeholders';
import '../../styles/pages/knowledge-library.scss';
---

<Layout>
  <div class="library-page">
    <PageIntro breadcrumb="Knowledge Library" eyebrow="Archivio di documenti e materiali" wideTitle>
      <Fragment slot="title"><span class="d-block">Knowledge</span>{' '}<span class="d-block text-secondary">Library.</span></Fragment>
      Consulta un patrimonio documentale selezionato e organizzato da AG Trustees per agevolare la consultazione e l’approfondimento.
    </PageIntro>

    <LibraryArchive documents={libraryDocumentPlaceholders} categories={libraryCategories} />

    <!-- TODO Strapi: sostituire testo e destinazione provvisori di Guide e tutorial, poi eliminare il commento. -->
    <CallToAction contained plainBackground eyebrow="AG Trustees — esperti in trust e pianificazione patrimoniale" label="Vai alla pagina">
      <Fragment slot="title">Guide e tutorial</Fragment>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam vel ipsum quis risus varius laoreet eu non libero. Phasellus vehicula diam et turpis ultricies, nec pulvinar eros faucibus. Suspendisse sodales vehicula augue, id ultrices turpis ullamcorper in. In porttitor quam ultricies elementum commodo.
    </CallToAction>
  </div>
</Layout>
