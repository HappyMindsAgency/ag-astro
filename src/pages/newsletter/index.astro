---
import Layout from '../../components/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import '../../styles/components/contact-section.scss';
import '../../styles/pages/newsletter.scss';
---

<Layout>
  <PageIntro titleAccent="newsletter" breadcrumb="Newsletter" parents={[{ label: 'AG Informa', href: '/ag-informa/' }]} eyebrow="AG Informa, arriva direttamente nella tua casella di posta" compact wideTitle>
    <Fragment slot="title">Iscriviti alla</Fragment>
    Iscriviti alla newsletter di AG Trustees per ricevere una selezione di notizie, approfondimenti e appuntamenti dedicati al trust, alla fiscalità e alle questioni patrimoniali.
  </PageIntro>

  <section class="newsletter-signup section-spacing" aria-label="Modulo di iscrizione alla newsletter">
    <div class="container section-container px-lg-0">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <NewsletterForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
