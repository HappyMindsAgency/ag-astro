---
import Layout from '../../components/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContactSection from '../../components/ContactSection.astro';
import NewsletterCallToAction from '../../components/NewsletterCallToAction.astro';
import FaqSection from '../../components/FaqSection.astro';
import OfficeMap from '../../components/OfficeMap.astro';
import { contacts, offices } from '../../data/contacts';
import '../../styles/pages/contatti.scss';

const faqs = [
  { question: 'Come posso richiedere un primo incontro?', answer: 'È possibile contattarci attraverso il modulo online, telefonicamente o via email. Un primo confronto permette di comprendere l’esigenza e individuare le professionalità da coinvolgere.' },
  { question: 'Quali informazioni devo fornire per essere ricontattato?', answer: 'È sufficiente indicare i propri recapiti e descrivere sinteticamente il motivo della richiesta. Eventuali documenti e informazioni più dettagliate potranno essere condivisi successivamente, nel rispetto della riservatezza.' },
  { question: 'Posso contattare AG Trustees anche se il trust non è ancora stato istituito?', answer: 'Sì. Possiamo partecipare alla fase preliminare insieme ai professionisti incaricati, contribuendo alla valutazione delle finalità, dei ruoli e delle modalità di amministrazione.' },
];
---

<Layout>
  <PageIntro titleAccent="AG Trustees" breadcrumb="Contatti" eyebrow="Ogni progetto comincia da un confronto" mobileTitleLeading="tight" wideTitle>
    <Fragment slot="title">Contatta</Fragment>
    Presentaci le tue esigenze o richiedi maggiori informazioni sui nostri servizi.
  </PageIntro>

  <section class="contact-offices section-spacing" aria-labelledby="contact-offices-title">
    <div class="container section-container px-lg-0">
      <div class="row align-items-end gy-4">
        <div class="col-lg-7">
          <p class="type-eyebrow type-eyebrow--section contact-offices-eyebrow">I nostri contatti</p>
          <h2 id="contact-offices-title" class="type-section-title contact-offices-title mb-0">Siamo a disposizione<br class="d-none d-xl-block" />{' '}<span>per informazioni<br class="d-none d-xxl-block" />{' '}o richieste</span></h2>
        </div>
        <div class="col-lg-5">
          <div class="contact-offices-links">
            <a class="contact-action-link" href={`mailto:${contacts.email}`}>
              <img src="/assets/icone/email.svg" width="29" height="24" alt="" />
              <span>{contacts.email}</span><span class="contact-action-arrow ms-auto" aria-hidden="true">→</span>
            </a>
            <a class="contact-action-link" href={`tel:${contacts.phone.replaceAll(' ', '')}`}>
              <img src="/assets/icone/telefono.svg" width="24" height="24" alt="" />
              <span>{contacts.phone}</span><span class="contact-action-arrow ms-auto" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
      <div class="row g-0 contact-office-list">
        {offices.map(({ city, street, postalCode }, index) => (
          <div class="col-md-4 contact-office">
            <p class="contact-office-index">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="contact-office-title">{city}</h3>
            <address class="mb-0">{street}<br />{postalCode} - {city}</address>
          </div>
        ))}
      </div>
    </div>
  </section>

  <OfficeMap>
    <Fragment slot="eyebrow">Dove siamo</Fragment>
    <Fragment slot="title">Le nostre <span class="type-section-title-accent">sedi.</span></Fragment>
  </OfficeMap>

  <ContactSection eyebrow="Contattaci" />

  <NewsletterCallToAction contained={false} />

  <FaqSection id="faq-contatti" items={faqs} largeTitle twoColumns>
    <Fragment slot="title">Domande<br /><span class="type-section-title-accent">frequenti</span></Fragment>
  </FaqSection>
</Layout>
