---
import { getArticoliHome } from '../lib/articoli';
import { getEventi } from '../lib/eventi';
import Layout from '../components/Layout.astro';
import ImageOverview from '../components/ImageOverview.astro';
import EditorialImage from '../components/EditorialImage.astro';
import ServiceOverview from '../components/ServiceOverview.astro';
import FeaturedEvent from '../components/FeaturedEvent.astro';
import NewsFeed from '../components/NewsFeed.astro';
import NewsletterCallToAction from '../components/NewsletterCallToAction.astro';
import '../styles/pages/home.scss';

const [articles, events] = await Promise.all([getArticoliHome('it'), getEventi('it')]);
const featuredEvent = events.find(event => event.inHome);

const companyDescription = 'Assume incarichi di trustee, co-trustee e guardiano e amministra i beni conferiti nel rispetto delle finalità stabilite.\n\nLa società riunisce in un’unica identità competenze giuridiche, fiscali, amministrative e contabili, insieme a una lunga esperienza nell’attività di trustee professionale.\n\nUn patrimonio di conoscenze oggi al servizio di una visione condivisa: amministrare ogni incarico con responsabilità, equilibrio e attenzione alle persone.';
const servicesIntroduction = 'AG Trustees interviene dalla definizione del progetto alla sua amministrazione nel tempo.';
const services = [
  { title: 'Assistenza nell’istituzione del trust', description: 'Contribuiamo alla definizione delle finalità, dei soggetti, dei ruoli e delle regole di amministrazione, insieme ai consulenti del disponente.' },
  { title: 'Trustee professionale', description: 'Assumiamo l’incarico di trustee e amministriamo i beni conferiti secondo l’atto istitutivo e la legge regolatrice.' },
  { title: 'Co-trustee', description: 'Condividiamo l’incarico con uno o più trustee, secondo la distribuzione di poteri e responsabilità prevista dal trust.' },
  { title: 'Guardiano', description: 'Vigiliamo sull’operato del trustee ed esercitiamo i poteri attribuiti dall’atto istitutivo.' },
  { title: 'Amministrazione e adempimenti', description: 'Curiamo la gestione operativa, la documentazione, la contabilità, la fiscalità e la rendicontazione del trust.' },
];
const needs = [
  'Custodire il patrimonio',
  'Pianificare il passaggio generazionale',
  'Organizzare il patrimonio familiare',
  'Tutelare persone fragili',
  'Garantire continuità dell\'impresa familiare',
  'Amministrare immobili, beni mobili o beni esteri',
];
const trustPoints = [
  'Definire il progetto',
  'Stabilire le regole',
  'Conferire i beni',
  'Amministrare e dare attuazione',
];
const values = [
  { title: 'Esperienza consolidata', description: 'Un patrimonio di competenze maturato nell’amministrazione professionale di trust.' },
  { title: 'Specializzazione', description: 'Conoscenze giuridiche, fiscali, amministrative dedicate alla gestione del trust.' },
  { title: 'Responsabilità', description: 'Ogni incarico viene valutato e amministrato con consapevolezza delle responsabilità che comporta.' },
  { title: 'Relazione', description: 'Manteniamo un dialogo chiaro e continuativo con le persone e i professionisti coinvolti.' },
  { title: 'Continuità', description: 'Seguiamo il trust durante il suo ciclo di vita, accompagnandone le decisioni e l’evoluzione.' },
  { title: 'Aggiornamento costante', description: 'Seguiamo l’evoluzione normativa, fiscale e giurisprudenziale per amministrare ogni incarico con competenza e consapevolezza.' },
];

---

<Layout headerHeroId="home-hero">
  <section id="home-hero" class="home-hero d-flex align-items-center" aria-labelledby="page-title">
    <div class="home-hero-content d-flex flex-column">
      <p class="home-hero-eyebrow d-flex align-items-center mb-0">AG Trustees</p>
      <h1 id="page-title" class="home-hero-title mb-0">
        <span class="d-block">Dare forma al patrimonio.</span>
        <span class="d-block type-section-title-accent">Custodirne il futuro.</span>
      </h1>
      <p class="home-hero-copy mb-0">AG Trustees è una società specializzata nei servizi di trust con sede a Milano, Bologna e Forlì. Affianchiamo persone, famiglie, imprenditori e professionisti nei progetti che riguardano patrimoni, imprese, relazioni e responsabilità destinate a proseguire nel tempo.</p>
      <div class="home-hero-actions d-flex flex-wrap">
        <a class="btn site-button" href="/chi-siamo/">Conosci AG Trustees <span aria-hidden="true">→</span></a>
        <a class="btn site-button site-button--light" href="/contatti/">Prenota una consulenza <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <ImageOverview id="home-company" eyebrow="Chi è AG Trustees" class="home-overview" plainImage image={{ src: '/assets/immagini/home/ag-trustees-trust-company.jpg', alt: 'Tre professionisti negli uffici di AG Trustees', width: 878, height: 669 }}>
    <img slot="decoration" class="home-brand-mark" src="/assets/brand/ag-logo-verticale-nero.png" width="1200" height="1145" alt="" aria-hidden="true" />
    <Fragment slot="title">Responsabilità nel presente, <span class="type-section-title-accent">continuità nel futuro</span></Fragment>
    {companyDescription.split('\n\n').map((paragraph, index) => <Fragment>{index > 0 && <Fragment><br /><br /></Fragment>}{paragraph}</Fragment>)}
    <a slot="action" class="btn site-button" href="/chi-siamo/">Conosci AG Trustees <span aria-hidden="true">→</span></a>
  </ImageOverview>

  <FeaturedEvent event={featuredEvent} />

  <ServiceOverview id="servizi" services={services} introduction={servicesIntroduction} eyebrow="Servizi professionali" title="Al fianco delle persone, nel tempo" actionLabel="Vai a tutti i servizi" />

  <section class="home-wealth home-contained section-spacing" aria-labelledby="home-wealth-title">
    <div class="container section-container px-lg-0">
      <div class="row gx-4 gy-4">
        <div class="col-lg-5"><p class="type-eyebrow type-eyebrow--section home-section-label">Patrimonio</p></div>
        <div class="col-lg-7">
          <h2 id="home-wealth-title" class="type-section-title type-section-title--compact">Il futuro si amministra <span class="type-section-title-accent d-xxl-block">con responsabilità</span></h2>
        </div>
      </div>
      <ol class="row g-0 home-wealth-grid list-unstyled mb-0">
        {needs.map((title, index) => (
          <li class="col-12 col-md-6 col-xxl-4 d-flex flex-column justify-content-between home-wealth-card">
            <span class="home-card-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="home-wealth-card-title mb-0">{title}</h3>
          </li>
        ))}
      </ol>
      <div class="text-center mt-4">
        <a class="btn site-button" href="/patrimonio/">Esplora la pagina Patrimonio <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-trust home-contained section-spacing" aria-labelledby="home-trust-title">
    <div class="container section-container px-lg-0">
      <div class="row gx-4 gy-4 align-items-center">
        <div class="col-lg-6"><EditorialImage src="/assets/immagini/home/ag-trustees-consulenza-trust.jpg" width={1024} height={1024} alt="Un confronto sulla documentazione di un incarico" plain /></div>
        <div class="col-lg-5 offset-lg-1">
          <p class="type-eyebrow type-eyebrow--section home-section-label">Che cos’è il trust?</p>
          <h2 id="home-trust-title" class="type-section-title type-section-title--compact">Uno strumento flessibile, regolato da finalità precise</h2>
          <p class="type-section-lead type-section-lead--relaxed home-section-copy">Il trust è un rapporto giuridico attraverso il quale determinati beni vengono affidati a un trustee, che ha il compito di amministrarli nell’interesse di uno o più beneficiari oppure per uno scopo definito.</p>
          <ol class="home-trust-points list-unstyled mb-0">
            {trustPoints.map((text, index) => (
              <li class="d-flex gap-3"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p class="mb-0">{text}</p></li>
            ))}
          </ol>
          <a class="btn site-button mt-4" href="/trust/">Scopri come funziona il trust <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-method home-contained section-spacing" aria-labelledby="home-method-title">
    <div class="container section-container px-lg-0">
      <div class="row gx-4 gy-4">
        <div class="col-lg-5 home-method-heading">
          <img class="home-brand-mark" src="/assets/brand/ag-logo-verticale-nero.png" width="1200" height="1145" alt="" aria-hidden="true" loading="lazy" />
          <p class="type-eyebrow type-eyebrow--section home-section-label">Perché AG Trustees</p>
          <h2 id="home-method-title" class="type-section-title type-section-title--compact mb-0">Competenza e responsabilità <span class="d-lg-block">nel tempo</span></h2>
        </div>
        <div class="col-lg-7">
          <div class="row g-0 home-values">
            {values.map(({ title, description }) => (
              <div class="col-md-6 home-value">
                <h3>{title}</h3>
                <p class="mb-0">{description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <NewsFeed articles={articles} eyebrow="Notizie e approfondimenti" />
  <NewsletterCallToAction contained={false} />
</Layout>

