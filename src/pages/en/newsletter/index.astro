---
import Layout from '../../../components/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import '../../../styles/components/contact-section.scss';
import '../../../styles/pages/newsletter.scss';

const lang = 'en';
---

<Layout lang={lang}>
  <PageIntro titleAccent="newsletter" inlineTitleAccent breadcrumb="Newsletter" parents={[{ label: 'AG Informa', href: '/en/ag-informa/' }]} eyebrow="AG Informa, delivered straight to your inbox." compact wideTitle titleSize="compact">
    <Fragment slot="title">Subscribe to our</Fragment>
    Subscribe to the AG Trustees newsletter to receive a curated selection of news, expert insights and upcoming events covering trusts, taxation and wealth-related matters.
  </PageIntro>

  <section class="newsletter-signup section-spacing" aria-label="Newsletter subscription form">
    <div class="container section-container px-lg-0">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <NewsletterForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
