---
import Layout from '../../../components/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import '../../../styles/components/contact-section.scss';
import '../../../styles/pages/newsletter.scss';

const professions = [
  { value: 'Notaio', label: 'Notary' },
  { value: 'Commercialista', label: 'Accountant' },
  { value: 'Avvocato', label: 'Lawyer' },
  { value: 'Altro', label: 'Other' },
];
const lang = 'en';
---

<Layout lang={lang}>
  <PageIntro breadcrumb="Newsletter" parents={[{ label: 'AG Informa', href: '/en/ag-informa/' }]} eyebrow="AG Informa, delivered straight to your inbox." compact wideTitle>
    <Fragment slot="title">Subscribe to our <span class="type-section-title-accent">newsletter</span></Fragment>
    Subscribe to the AG Trustees newsletter to receive a curated selection of news, expert insights and upcoming events covering trusts, taxation and wealth-related matters.
  </PageIntro>

  <section class="newsletter-signup section-spacing" aria-label="Newsletter subscription form">
    <div class="container section-container px-lg-0">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <form class="contact-form" method="post" aria-label="Newsletter subscription">
            <div class="row g-4">
              <div class="col-md-6">
                <label class="form-label" for="signup-first-name">First name *</label>
                <input class="form-control" id="signup-first-name" name="firstName" type="text" autocomplete="given-name" required />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="signup-last-name">Last name *</label>
                <input class="form-control" id="signup-last-name" name="lastName" type="text" autocomplete="family-name" required />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="signup-email">Email address *</label>
                <input class="form-control" id="signup-email" name="email" type="email" autocomplete="email" required />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="signup-city">City *</label>
                <input class="form-control" id="signup-city" name="city" type="text" autocomplete="address-level2" required />
              </div>
              <fieldset class="col-12">
                <legend class="form-label">Profession *</legend>
                <div class="d-flex flex-wrap gap-3 gap-md-4">
                  {professions.map(({ value, label }, index) => (
                    <div class="form-check mb-0">
                      <input class="form-check-input" id={`signup-profession-${index}`} name="profession" type="radio" value={value} required />
                      <label class="form-check-label" for={`signup-profession-${index}`}>{label}</label>
                    </div>
                  ))}
                </div>
              </fieldset>
            </div>
            <div class="form-check mt-4">
              <input class="form-check-input" id="signup-privacy" name="privacy" type="checkbox" required />
              <label class="form-check-label" for="signup-privacy">I consent to the processing of my personal data as described in the <a href="/en/privacy-policy/">Privacy Policy</a>. *</label>
            </div>
            <button class="btn site-button contact-form-submit" type="submit" disabled>Subscribe to our newsletter <span aria-hidden="true">→</span></button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
