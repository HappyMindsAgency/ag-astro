---
import { getEventi, getProssimiEventi, getEventiDaNonPerdere } from '../../../lib/eventi';
import customSlug from '../../../lib/utility-customslug';
import Layout from '../../../components/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import EventList from '../../../components/EventList.astro';
import NewsletterCallToAction from '../../../components/NewsletterCallToAction.astro';
import '../../../styles/pages/eventi.scss';

const events = await getEventi('en');
const upcomingEvents = getProssimiEventi(events);
const highlightedEvents = getEventiDaNonPerdere(events);

const lang = 'en';
---

<Layout lang={lang}>
  <div class="events-page">
    <PageIntro titleAccent="events" inlineTitleAccent breadcrumb="Upcoming events" eyebrow="Events calendar" wideTitle>
      <Fragment slot="title">Upcoming</Fragment>
      Conferences, seminars and professional development events exploring trusts, taxation and long-term wealth planning.
    </PageIntro>

    <EventList id="prossimi-eventi" title="Upcoming events" eyebrow="Events calendar" events={upcomingEvents.slice(0, 6)} />
    <EventList id="eventi-da-non-perdere" title="Events not to be missed" eyebrow="Events calendar" events={highlightedEvents.slice(0, 6)} calendarHref={customSlug('eventsNotToMiss', lang)} compact />

    <NewsletterCallToAction title="AG Informa – News and updates">
      Receive a curated selection of news, expert insights and upcoming events to stay informed about developments in trusts and wealth-related matters.
    </NewsletterCallToAction>
  </div>
</Layout>
