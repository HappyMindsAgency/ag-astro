---
import { leadershipPlaceholder, operationalPlaceholder, counselPlaceholder } from '../../../../data/team-placeholders';
import type { TeamMember } from '../../../../types/content';
import Layout from '../../../../components/Layout.astro';
import PageIntro from '../../../../components/PageIntro.astro';
import TeamMemberCard from '../../../../components/TeamMemberCard.astro';
import ContactSection from '../../../../components/ContactSection.astro';
import NewsletterCallToAction from '../../../../components/NewsletterCallToAction.astro';
import '../../../../styles/pages/team.scss';

interface TeamSection {
  id: 'leadership' | 'operational' | 'counsel';
  eyebrow: string;
  title: string;
  accent: string;
  members: TeamMember[];
}

const sections: TeamSection[] = [
  { id: 'leadership', eyebrow: "Leadership", title: "Guiding the company's", accent: 'growth', members: leadershipPlaceholder },
  { id: 'operational', eyebrow: "Team", title: 'Managing the day-to-day', accent: 'responsibilities', members: operationalPlaceholder },
  { id: 'counsel', eyebrow: "Of counsel", title: 'Supporting complex', accent: 'decisions', members: counselPlaceholder },
];
const lang = 'en';
---

<Layout lang={lang}>
  <PageIntro breadcrumb="Team" parents={[{ label: 'About us', href: '/en/about-us/' }]} eyebrow="Trust begins with people">
    <Fragment slot="title"><span class="d-block">Meet our</span>{' '}<span class="d-block text-secondary">team</span></Fragment>
    A range of expertise, a shared commitment: to approach every appointment with care, professionalism and a long-term perspective.
  </PageIntro>

  {sections.filter(({ members }) => members.length > 0).map(({ id, eyebrow, title, accent, members }) => (
    <section class:list={['team-section section-spacing', `team-section--${id}`]} aria-labelledby={`team-${id}-title`}>
      {id === 'operational' && <img class="team-section-mark d-none d-lg-block" src="/assets/brand/ag-logo-verticale-nero.png" width="1200" height="1145" alt="" aria-hidden="true" loading="lazy" />}
      <div class:list={['container section-container', { 'px-0': id === 'leadership' }]}>
        <div class="row gx-4 gy-4 align-items-end team-section-header">
          <div class="col-12">
            <p class="type-eyebrow type-eyebrow--section team-section-eyebrow">{eyebrow}</p>
            <h2 id={`team-${id}-title`} class="type-section-title mb-0">{title}{' '}<span class="type-section-title-accent team-section-title-accent d-lg-block">{accent}</span></h2>
          </div>
        </div>
        <div class:list={[
          'row team-members',
          {
            'gx-0 gy-4 gy-xxl-0 row-cols-1 row-cols-xxl-3 justify-content-center': id === 'leadership',
            'gx-0 gy-4 row-cols-1 row-cols-xl-2': id === 'operational',
            'g-3 g-lg-4 row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xxl-5': id === 'counsel',
          },
        ]}>
          {members.map((member) => <div class="col"><TeamMemberCard member={member} variant={id} /></div>)}
        </div>
      </div>
    </section>
  ))}

  <ContactSection eyebrow="Contact us" title="Speak to one of our advisors">At AG Trustees, we offer specialist expertise, long-term commitment and professional relationships built on trust.</ContactSection>

  <NewsletterCallToAction contained={false} />
</Layout>
