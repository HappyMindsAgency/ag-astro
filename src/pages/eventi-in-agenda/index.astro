---
import { getEventi, getProssimiEventi } from '../../lib/eventi';
import Layout from '../../components/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EventList from '../../components/EventList.astro';
import NewsletterCallToAction from '../../components/NewsletterCallToAction.astro';
import '../../styles/pages/eventi.scss';

const events = await getEventi('it');
const upcomingEvents = getProssimiEventi(events);
const highlightedEvents = events.filter(event => event.notToMiss);
---

<Layout>
  <div class="events-page">
    <PageIntro titleAccent="in agenda" breadcrumb="Eventi in agenda" eyebrow="Calendario eventi" wideTitle>
      <Fragment slot="title">Eventi</Fragment>
      Convegni, seminari e appuntamenti formativi per approfondire i temi del trust, della fiscalità e della continuità patrimoniale.
    </PageIntro>

    <EventList id="prossimi-eventi" title="Prossimi eventi" eyebrow="In agenda" events={upcomingEvents} />
    <EventList id="eventi-da-non-perdere" title="Eventi da non perdere" eyebrow="In agenda" events={highlightedEvents} compact />

    <NewsletterCallToAction />
  </div>
</Layout>
