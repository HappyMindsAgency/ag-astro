---
import { eventPlaceholders } from '../../data/event-placeholders';
import Layout from '../../components/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EventList from '../../components/EventList.astro';
import NewsletterCallToAction from '../../components/NewsletterCallToAction.astro';
import '../../styles/pages/eventi.scss';


---

<Layout>
  <div class="events-page">
    <PageIntro breadcrumb="Eventi in agenda" eyebrow="Eventi" wideTitle>
      <Fragment slot="title"><span class="d-block">Eventi</span>{' '}<span class="d-block text-secondary">in agenda<span class="d-lg-none">.</span></span></Fragment>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut accumsan magna vitae vestibulum efficitur.
    </PageIntro>

    <EventList id="prossimi-eventi" title="Prossimi eventi" eyebrow="In agenda" events={eventPlaceholders} />
    <EventList id="eventi-da-non-perdere" title="Eventi da non perdere" eyebrow="In agenda" events={eventPlaceholders} compact />

    <NewsletterCallToAction />
  </div>
</Layout>
