---
import SiteSearch from './SiteSearch.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import customLabel from '../lib/utility-customlabel';
import customSlug from '../lib/utility-customslug';
import { getLangFromUrl, localizeHref, type Locale } from '../lib/lang-switch/route-map';

interface Props {
  linkedinUrl?: string;
  heroId?: string;
  lang?: Locale;
  languageUrls?: Partial<Record<Locale, string>>;
}

const { linkedinUrl, heroId, lang = getLangFromUrl(Astro.url), languageUrls } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const contactIsCurrent = currentPath === customSlug('contact', lang).replace(/\/$/, '');
interface NavigationItem {
  label: string;
  href: string;
  children?: { label: string; href?: string }[];
}

const navigation: NavigationItem[] = [
  {
    label: 'Chi siamo',
    href: '/chi-siamo/',
    children: [
      { label: 'Visione e metodologia', href: '/chi-siamo/visione-metodologia/' },
      { label: 'Il team', href: '/chi-siamo/team/' },
      { label: 'Galvani Fiduciaria e Argos Trustees', href: '/chi-siamo/galvani-fiduciaria-argos-trustees/' },
    ],
  },
  { label: 'Servizi', href: '/servizi/' },
  { label: 'Trust', href: '/trust/' },
  { label: 'Patrimonio', href: '/patrimonio/' },
  { label: 'AG Informa', href: '/ag-informa/' },
  { label: 'Eventi', href: '/eventi-in-agenda/' },
  { label: 'Knowledge library', href: '/knowledge-library/' },
];
---

<header class:list={['site-header sticky-top', { 'bg-white': !heroId, 'site-header--hero is-over-hero': heroId }]} data-header-hero={heroId}>
  <nav class="navbar navbar-expand-xl site-navbar" aria-label={customLabel('Navigazione principale', lang)}>
    <div class="container-fluid flex-nowrap p-0">
      <a class="navbar-brand m-0" href={customSlug('home', lang)} aria-label="AG Trustees — Homepage">
        <img class="d-block w-100 h-auto" src="/assets/brand/ag-logo-orizzontale.png" alt="Across Galvani Trustees" width="1086" height="126" fetchpriority="high" />
      </a>

      <div class="d-flex d-xl-none align-items-center gap-2">
        <a class:list={['header-contact header-contact-mobile', { active: contactIsCurrent }]} href={customSlug('contact', lang)} data-label={`${customLabel('Contatti', lang)} →`} aria-current={contactIsCurrent ? 'page' : undefined}><span>{customLabel('Contatti', lang)} <span aria-hidden="true">→</span></span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-navigation" aria-controls="site-navigation" aria-expanded="false" aria-label={customLabel('Apri o chiudi il menu', lang)}>
          <span class="navbar-toggler-icon" aria-hidden="true"></span>
        </button>
      </div>

      <div class="collapse navbar-collapse align-items-xl-baseline" id="site-navigation">
        <ul class="navbar-nav">
          {navigation.map(({ label, href, children }) => {
            const localizedHref = localizeHref(href, lang)!;
            const localizedLabel = customLabel(label, lang);
            const isCurrent = currentPath === localizedHref.replace(/\/$/, '');
            const isActive = isCurrent || currentPath.startsWith(localizedHref);
            const submenuId = `submenu-${href.split('/')[1]}`;
            return (
              <li class:list={['nav-item', { dropdown: children }]}>
                <div class="header-nav-row d-flex flex-wrap flex-xl-nowrap align-items-center">
                  <a class:list={['nav-link', { active: isActive }]} href={localizedHref} data-label={localizedLabel} aria-current={isCurrent ? 'page' : undefined}>{localizedLabel}</a>
                  {children && (
                    <button
                      class="header-submenu-toggle dropdown-toggle dropdown-toggle-split"
                      type="button"
                      data-bs-toggle="dropdown"
                      data-bs-display="static"
                      aria-controls={submenuId}
                      aria-expanded="false"
                      aria-label={customLabel('Apri o chiudi il sottomenu {label}', lang, { label: localizedLabel })}
                    ></button>
                  )}
                  {children && (
                    <ul class="dropdown-menu header-submenu" id={submenuId} aria-label={customLabel('Sottomenu {label}', lang, { label: localizedLabel })}>
                      {children.map(({ label: childLabel, href: childHref }) => {
                        const localizedChildHref = localizeHref(childHref, lang);
                        const childIsCurrent = localizedChildHref && currentPath === localizedChildHref.replace(/\/$/, '');
                        return (
                          <li>{childHref ? (
                            <a class:list={['dropdown-item text-wrap', { active: childIsCurrent }]} href={localizedChildHref} aria-current={childIsCurrent ? 'page' : undefined}>{customLabel(childLabel, lang)}</a>
                          ) : (
                            <span class="dropdown-item text-wrap disabled" aria-disabled="true">{customLabel(childLabel, lang)}</span>
                          )}</li>
                        );
                      })}
                    </ul>
                  )}
                </div>
              </li>
            );
          })}
        </ul>

        <a class="btn site-button header-menu-cta w-100 d-xl-none" href={customSlug('contact', lang)}>{customLabel('Contatti', lang)} <span aria-hidden="true">→</span></a>

        <div class="header-tools d-flex align-items-baseline">
          <a class:list={['header-contact d-none d-xl-inline-flex', { active: contactIsCurrent }]} href={customSlug('contact', lang)} data-label={customLabel('Contatti', lang)} aria-current={contactIsCurrent ? 'page' : undefined}>{customLabel('Contatti', lang)}</a>
          <span class="vr d-none d-xl-inline-block"></span>
          {/* LinkedIn precede la lente solo nel menu compatto: due copie mantengono l’ordine del Tab uguale a quello visivo. */}
          {linkedinUrl && <a class="header-icon d-xl-none" href={linkedinUrl} aria-label={customLabel('AG Trustees su LinkedIn', lang)}><img src="/assets/icone/linkedin.svg" width="16" height="17" alt="" /></a>}
          <SiteSearch />
          <span class="vr d-none d-xl-inline-block"></span>
          {linkedinUrl && <>
            <a class="header-icon d-none d-xl-inline-flex" href={linkedinUrl} aria-label={customLabel('AG Trustees su LinkedIn', lang)}><img src="/assets/icone/linkedin.svg" width="16" height="17" alt="" /></a>
            <span class="vr d-none d-xl-inline-block"></span>
          </>}
          <LanguageSwitch lang={lang} urls={languageUrls} />
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  import Collapse from 'bootstrap/js/dist/collapse';
  import Dropdown from 'bootstrap/js/dist/dropdown';
  import FocusTrap from 'bootstrap/js/dist/util/focustrap';

  document.querySelectorAll<HTMLElement>('.site-navbar').forEach((navbar) => {
    const breakpoint = getComputedStyle(document.documentElement).getPropertyValue('--bs-breakpoint-xl').trim();
    const desktop = matchMedia(`(min-width: ${breakpoint})`);
    const desktopHover = matchMedia(`(min-width: ${breakpoint}) and (hover: hover) and (pointer: fine)`);
    const header = navbar.closest<HTMLElement>('.site-header');
    const panel = navbar.querySelector<HTMLElement>('.navbar-collapse');
    const toggler = navbar.querySelector<HTMLButtonElement>('.navbar-toggler');

    const hero = header?.dataset.headerHero ? document.getElementById(header.dataset.headerHero) : null;
    if (header && hero) {
      const updateHeroHeader = () => {
        header.classList.toggle('is-over-hero', window.scrollY <= 8);
      };
      updateHeroHeader();
      window.addEventListener('scroll', updateHeroHeader, { passive: true });
      window.addEventListener('pageshow', updateHeroHeader);
    }

    if (header && panel && toggler) {
      const menu = Collapse.getOrCreateInstance(panel, { toggle: false });
      const focusTrap = new FocusTrap({ trapElement: navbar, autofocus: false });

      panel.addEventListener('shown.bs.collapse', (event) => {
        if (event.target !== panel) return;
        if (desktop.matches) menu.hide();
        else focusTrap.activate();
      });

      panel.addEventListener('hide.bs.collapse', (event) => {
        if (event.target !== panel) return;
        focusTrap.deactivate();
        if (!desktop.matches && panel.contains(document.activeElement)) toggler.focus();
      });

      desktop.addEventListener('change', () => {
        focusTrap.deactivate();
        menu.hide();
      });

      // Lo sfondo oscurato è un pseudo-elemento dell'header.
      header.addEventListener('click', (event) => {
        if (event.target === header) menu.hide();
      });

      navbar.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || desktop.matches || !panel.classList.contains('show')) return;
        menu.hide();
        toggler.focus();
      });
    }

    // Uscendo con il mouse il sottomenu resta aperto per un attimo: un percorso lento o in diagonale non lo chiude.
    let pendingClose: { item: HTMLElement; hide: () => void; timer: number } | undefined;
    const settleClose = (item: HTMLElement) => {
      if (!pendingClose) return;
      window.clearTimeout(pendingClose.timer);
      if (pendingClose.item !== item) pendingClose.hide();
      pendingClose = undefined;
    };

    navbar.querySelectorAll<HTMLElement>('.dropdown').forEach((item) => {
      const toggle = item.querySelector<HTMLButtonElement>('.header-submenu-toggle');
      if (!toggle) return;

      const dropdown = Dropdown.getOrCreateInstance(toggle);

      item.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse' || !desktopHover.matches) return;
        settleClose(item);

        // Su hover ripristino il focus che Bootstrap sposta sulla freccia.
        const focused = document.activeElement;
        dropdown.show();

        if (focused instanceof HTMLElement && focused !== document.body) {
          focused.focus({ preventScroll: true });
        } else {
          toggle.blur();
        }
      });

      item.addEventListener('pointerleave', (event) => {
        if (event.pointerType !== 'mouse' || !desktopHover.matches || item.contains(document.activeElement)) return;
        const hide = () => dropdown.hide();
        pendingClose = { item, hide, timer: window.setTimeout(() => { pendingClose = undefined; hide(); }, 300) };
      });

      item.addEventListener('focusout', () => {
        requestAnimationFrame(() => {
          // Durante un clic chiude Bootstrap: chiudere prima sposterebbe i pulsanti sotto il puntatore.
          if (navbar.matches(':active')) return;
          if (!item.contains(document.activeElement) && (!desktopHover.matches || !item.matches(':hover'))) dropdown.hide();
        });
      });

      desktopHover.addEventListener('change', () => dropdown.hide());
    });
  });
</script>
