---
import '../styles/components/editorial-image.scss';

interface Props {
  src: string;
  alt?: string;
  width: number;
  height: number;
  plain?: boolean;
}

const { src, alt = '', width, height, plain = false } = Astro.props;
---

<div class:list={['editorial-image', { 'editorial-image--plain': plain }]}>
  <img {src} {alt} {width} {height} loading="lazy" />
</div>
