---
import '../styles/components/related-content.scss';

interface Article {
  title: string;
  href: string;
  image: { src: string; alt: string; width: number; height: number };
  category: string;
  date: string;
  dateTime: string;
  excerpt: string;
}

interface Document {
  title: string;
  downloadUrl: string;
  category: string;
  abbreviation: string;
  metadata: string;
}

interface Props {
  articles?: Article[];
  documents?: Document[];
}

const { articles = [], documents = [] } = Astro.props;
---

{(articles.length > 0 || documents.length > 0) && (
  <div class="related-content section-spacing">
    <div class="container">
      {articles.length > 0 && (
        <section aria-labelledby="related-articles-title">
          <p class="type-eyebrow type-eyebrow--section related-eyebrow">Approfondimenti</p>
          <h2 id="related-articles-title" class="related-title">Articoli correlati</h2>
          <div class="row gx-5 gy-5">
            {articles.map(({ title, href, image, category, date, dateTime, excerpt }) => (
              <article class="col-md-6 col-lg-4 related-article">
                <a class="related-article-link" href={href}>
                  <img class="related-article-image" src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" />
                  <p class="related-article-meta"><span>{category}</span> <span aria-hidden="true">|</span> <time datetime={dateTime}>{date}</time></p>
                  <h3 class="related-article-title">{title}</h3>
                </a>
                <p class="related-article-excerpt mb-0">{excerpt}</p>
              </article>
            ))}
          </div>
        </section>
      )}
      {documents.length > 0 && (
        <section class:list={{ 'related-documents': articles.length > 0 }} aria-labelledby="related-documents-title">
          <h2 id="related-documents-title" class="related-title">Documenti correlati</h2>
          <ul class="row gx-5 gy-0 list-unstyled mb-0">
            {documents.map(({ title, downloadUrl, category, abbreviation, metadata }) => (
              <li class="col-lg-6">
                <div class="related-document d-flex align-items-center gap-3">
                  <span class="related-document-badge" aria-hidden="true">{abbreviation}</span>
                  <div class="flex-grow-1">
                    <h3 class="related-document-title">{title}</h3>
                    <p class="related-document-meta mb-0"><span>{category}</span>{' | '}{metadata}</p>
                  </div>
                  <a class="btn site-button site-button--outline-blue related-document-download" href={downloadUrl} download aria-label={`Scarica PDF: ${title}`}>
                    <span aria-hidden="true">↓</span> Scarica PDF
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
      <div class="related-action text-center">
        <a class="btn site-button site-button--blue" href="/knowledge-library/">Consulta la Knowledge Library <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
)}
