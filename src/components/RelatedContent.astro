---
import '../styles/components/related-content.scss';
import type { ArticlePreview, DocumentPreview } from '../types/content';
import DocumentList from './DocumentList.astro';

interface Props {
  articles?: ArticlePreview[];
  documents?: DocumentPreview[];
  eyebrow?: string;
  title?: string;
  introduction?: string;
  showLibraryLink?: boolean;
  showArticlesLink?: boolean;
}

const { articles = [], documents = [], eyebrow = 'Approfondimenti', title, introduction, showLibraryLink = true, showArticlesLink = false } = Astro.props;
const SectionHeading = title ? 'h3' : 'h2';
const ArticleHeading = title ? 'h4' : 'h3';
---

{(articles.length > 0 || documents.length > 0) && (
  <div class="related-content section-spacing">
    <div class="container section-container">
      {title && (
        <div class="row gx-4 gy-4 align-items-end mb-5">
          <div class={introduction ? 'col-lg-7' : 'col-12'}>
            <p class="type-eyebrow type-eyebrow--section related-eyebrow">{eyebrow}</p>
            <h2 class="type-section-title type-section-title--compact mb-0">{title}</h2>
          </div>
          {introduction && <p class="col-lg-5 type-section-lead mb-0">{introduction}</p>}
        </div>
      )}
      {articles.length > 0 && (
        <section aria-labelledby="related-articles-title">
          <div class="related-articles-header d-flex flex-wrap align-items-end justify-content-between">
            <div>
              {!title && <p class="type-eyebrow type-eyebrow--section related-eyebrow">{eyebrow}</p>}
              <SectionHeading id="related-articles-title" class="related-title">Articoli correlati</SectionHeading>
            </div>
            <slot name="articles-action" />
          </div>
          <div class="row gx-5 gy-5">
            {articles.map(({ title, href, image, category, date, dateTime, excerpt }) => (
              <article class="col-md-6 col-lg-4 related-article">
                <a class="related-article-link" href={href}>
                  <img class="related-article-image" src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" />
                  <p class="related-article-meta"><span>{category}</span> <span aria-hidden="true">|</span> <time datetime={dateTime}>{date}</time></p>
                  <ArticleHeading class="related-article-title site-title-link">{title}</ArticleHeading>
                </a>
                <p class="related-article-excerpt mb-0">{excerpt}</p>
              </article>
            ))}
          </div>
        </section>
      )}
      {documents.length > 0 && (
        <section class:list={{ 'related-documents': articles.length > 0 }} aria-labelledby="related-documents-title">
          <SectionHeading id="related-documents-title" class="related-title">Documenti correlati</SectionHeading>
          <DocumentList documents={documents} headingTag={title ? 'h4' : 'h3'} />
        </section>
      )}
      {(showLibraryLink || showArticlesLink) && <div class:list={['related-action text-center', { 'd-flex flex-wrap justify-content-center gap-3': showArticlesLink }]}>
        {showLibraryLink && <a class="btn site-button site-button--blue site-button--small" href="/knowledge-library/">Consulta la Knowledge Library <span aria-hidden="true">→</span></a>}
        {showArticlesLink && <a class="btn site-button site-button--outline-blue site-button--small" href="/ag-informa/">Leggi gli approfondimenti <span aria-hidden="true">→</span></a>}
      </div>}
    </div>
  </div>
)}
