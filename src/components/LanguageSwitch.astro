---
import customLabel from '../lib/utility-customlabel';
import { getLangFromUrl, languageSwitchUrl, type Locale } from '../lib/lang-switch/route-map';

interface Props { lang?: Locale; urls?: Partial<Record<Locale, string>>; }
const { lang = getLangFromUrl(Astro.url), urls } = Astro.props;
const languages: { locale: Locale; code: string; name: string }[] = [
  { locale: 'it', code: 'ITA', name: 'Italiano' },
  { locale: 'en', code: 'ENG', name: 'English' },
];
const currentCode = languages.find(({ locale }) => locale === lang)?.code;
---

<div class="dropdown header-language-picker position-static ms-auto">
  <button class="header-language dropdown-toggle d-none d-xl-inline-flex" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" aria-label={customLabel('Seleziona la lingua', lang)}>
    {currentCode}
  </button>
  <ul class="dropdown-menu dropdown-menu-end header-language-menu" data-label={currentCode} aria-label={customLabel('Seleziona la lingua', lang)}>
    {languages.map(({ locale, code, name }) => (
      <li><a class:list={['dropdown-item', { active: locale === lang }]} href={urls?.[locale] ?? languageSwitchUrl(Astro.url.pathname, locale)} lang={locale} hreflang={locale} aria-label={name} aria-current={locale === lang ? 'true' : undefined}>{code}</a></li>
    ))}
  </ul>
</div>
