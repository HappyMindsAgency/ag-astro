---
import type { EventPreview } from '../types/content';
import '../styles/components/event-card.scss';

interface Props {
  event: EventPreview;
  compact?: boolean;
}

const { event, compact = false } = Astro.props;
---

<article class:list={['event-card', { 'event-card--compact': compact }]}>
  {!compact && event.image && <img class="event-card-image" src={event.image.src} alt={event.image.alt} width={event.image.width} height={event.image.height} loading="lazy" />}
  <div class="event-card-body d-flex align-items-start">
    <time class="event-card-date" datetime={event.date.dateTime} aria-label={`${event.date.days} ${event.date.month} ${event.date.year}`}>
      <span class="event-card-day">{event.date.days}</span>
      <span class="event-card-month">{event.date.month}</span>
      <span class="event-card-year">{event.date.year}</span>
    </time>
    <div class="event-card-content">
      <div class="event-card-meta d-flex flex-wrap align-items-center">
        {event.format && <span class:list={['event-card-format', { 'event-card-format--webinar': event.format === 'Webinar', 'event-card-format--seminar': event.format === 'Seminario' }]}>{event.format}</span>}
        <span class="event-card-location d-inline-flex align-items-center"><span class="event-card-pin" aria-hidden="true"></span>{event.location}</span>
      </div>
      <h3 class="event-card-title">{event.title}</h3>
      {!compact && event.description && <p class="event-card-description">{event.description}</p>}
      <a class="site-text-link" href={event.href} aria-disabled={event.href ? undefined : 'true'} aria-label={`Dettagli: ${event.title}`}>Dettagli <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
