---
import '../styles/components/service-overview.scss';

interface Props {
  id: string;
  services: { title: string; description: string }[];
  introduction?: string;
  eyebrow?: string;
  title?: string;
  actionLabel?: string;
  backgroundImage?: string;
}

const { id, services, introduction, eyebrow = 'Aree di attività', title = 'Servizi professionali', actionLabel = 'Tutti i servizi', backgroundImage } = Astro.props;
---

<section id={id} class="service-overview section-spacing" style={backgroundImage ? { '--section-background-image': `url("${backgroundImage}")` } : undefined} aria-labelledby={`${id}-title`}>
  <div class="container section-container">
    <div class="service-overview-heading text-lg-center mx-auto">
      <p class="type-eyebrow type-eyebrow--section service-overview-eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`} class="service-overview-title">{title}</h2>
      {introduction && <p class="service-overview-copy mb-0">{introduction}</p>}
    </div>
    <ol class="service-overview-list list-unstyled mx-auto mb-0">
      {services.map(({ title, description }, index) => (
        <li class="row g-0 align-items-center service-overview-item service-list-row">
          <span class="col-1 service-overview-item-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="col-5 service-overview-item-title mb-0">{title}</h3>
          <p class="col-6 service-overview-item-copy mb-0">{description}</p>
        </li>
      ))}
    </ol>
    <div class="service-overview-action text-end mx-auto">
      <a class="btn site-button site-button--outline-light" href="/servizi/">{actionLabel} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
