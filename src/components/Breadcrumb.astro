---
import '../styles/components/breadcrumb.scss';
import customLabel from '../lib/utility-customlabel';
import customSlug from '../lib/utility-customslug';
import { getLangFromUrl, localizeHref } from '../lib/lang-switch/route-map';
import { toJsonLd } from '../lib/seo';

interface Props {
  current: string;
  parents?: { label: string; href: string }[];
  light?: boolean;
}

const { current, parents = [], light = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const origin = (Astro.site ?? Astro.url).origin;
const trail = [{ label: 'Home', href: customSlug('home', lang) }, ...parents.map(({ label, href }) => ({ label: customLabel(label, lang), href: localizeHref(href, lang) }))];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [...trail, { label: current, href: Astro.url.pathname }].map(({ label, href }, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: label,
    item: href ? new URL(href, origin).href : undefined,
  })),
};
---

<nav aria-label={customLabel('Percorso di navigazione', lang)}>
  <ol class:list={['breadcrumb site-breadcrumb', { 'site-breadcrumb--light': light }]}>
    <li class="breadcrumb-item"><a href={customSlug('home', lang)}>Home</a></li>
    {parents.map(({ label, href }) => <li class="breadcrumb-item"><a href={localizeHref(href, lang)}>{customLabel(label, lang)}</a></li>)}
    <li class="breadcrumb-item active" aria-current="page">{current}</li>
  </ol>
</nav>
<script type="application/ld+json" set:html={toJsonLd(jsonLd)} />
