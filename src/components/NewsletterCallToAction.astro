---
import CallToAction from './CallToAction.astro';

interface Props {
  latestNewsletterUrl?: string;
}

const { latestNewsletterUrl } = Astro.props;
---

<CallToAction contained eyebrow="AG Trustees — esperti in trust e pianificazione patrimoniale" href={latestNewsletterUrl} label="Leggi l’ultima newsletter" secondaryAction={{ label: 'Iscriviti alla newsletter', href: '/contatti/#newsletter' }}>
  <Fragment slot="title">AG informa - Ricevi notizie e aggiornamenti</Fragment>
  Ricevi una selezione di notizie, approfondimenti e appuntamenti per seguire l’evoluzione del trust e delle questioni patrimoniali.
</CallToAction>
