---
import CallToAction from './CallToAction.astro';
import customLabel from '../lib/utility-customlabel';
import { getLangFromUrl } from '../lib/lang-switch/route-map';

interface Props {
  contained?: boolean;
  latestNewsletterUrl?: string;
  plainBackground?: boolean;
  title?: string;
}

const { contained = true, latestNewsletterUrl = '', plainBackground = false, title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const latestUrl = latestNewsletterUrl?.trim();
---

<CallToAction contained={contained} plainBackground={plainBackground} backgroundImage="/assets/immagini/ag-trustees-servizi-professionali-newsletter.jpg" eyebrow="AG Trustees — esperti in trust e pianificazione patrimoniale" href="/newsletter/" label="Iscriviti alla newsletter" secondaryAction={latestUrl ? { label: 'Leggi l’ultima newsletter', href: latestUrl } : undefined}>
  <Fragment slot="title">{title ?? customLabel('AG informa - Ricevi notizie e aggiornamenti', lang)}</Fragment>
  <slot>{customLabel('Ricevi una selezione di notizie, approfondimenti e appuntamenti per seguire l’evoluzione del trust e delle questioni patrimoniali.', lang)}</slot>
</CallToAction>
