---
import customLabel from '../lib/utility-customlabel';
import { getLangFromUrl } from '../lib/lang-switch/route-map';
import '../styles/components/certifications.scss';

const logos = [
  { src: '/assets/associazioni/il-trust-in-italia.png', alt: 'Il Trust in Italia ETS', width: 2560, height: 1005, className: 'certifications-logo--wide' },
  { src: '/assets/associazioni/step.png', alt: 'STEP', width: 820, height: 247, className: 'certifications-logo--wide' },
  { src: '/assets/associazioni/tpe.png', alt: 'Trustee Protector Expert', width: 1444, height: 1531, className: 'certifications-logo--badge' },
  { src: '/assets/associazioni/cte.png', alt: 'Chartered Trust Expert', width: 1504, height: 1495, className: 'certifications-logo--badge' },
];
const lang = getLangFromUrl(Astro.url);
---

<section id="certificazioni" class="certifications" aria-labelledby="certifications-title">
  <div class="row g-0">
    <div class="col-md-6 col-xxl-5 order-md-2 d-flex flex-column certifications-heading">
      <p class="type-eyebrow type-eyebrow--section mb-0">{customLabel('Trasparenza e aggiornamento professionale', lang)}</p>
      <h2 id="certifications-title" class="type-section-title mb-0">{customLabel('Certificazioni e associazioni.', lang)}</h2>
      <a class="btn site-button site-button--light d-md-none" href="#certifications-logos">
        {customLabel('Scopri di più', lang)} <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div id="certifications-logos" class="col-md-6 col-xxl-7 order-md-1 d-md-flex align-items-center certifications-logos">
      <ul class="row row-cols-2 gx-4 gx-lg-5 align-items-center w-100 mx-auto list-unstyled mb-0" aria-label={customLabel('Associazioni e certificazioni', lang)}>
        {logos.map((logo) => (
          <li class="certifications-logo">
            <img class={logo.className} src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
