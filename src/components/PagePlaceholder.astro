---
import Layout from './Layout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <section class="container py-5" aria-labelledby="page-title">
    <h1 id="page-title" class="type-section-title mb-0">{title}</h1>
    <slot />
  </section>
</Layout>
