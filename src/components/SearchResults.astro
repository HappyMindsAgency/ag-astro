---
import type { SearchResult } from '../types/content';
import { searchResultTypes } from '../data/search';
import SearchHighlight from './SearchHighlight.astro';
import '../styles/components/content-filter.scss';
import '../styles/components/library-archive.scss';
import '../styles/components/search-results.scss';

interface Props {
  query: string;
  results: SearchResult[];
}

const { query, results } = Astro.props;
const dateFormat = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const filters = Object.entries(searchResultTypes)
  .map(([value, { plural }]) => ({ value, label: plural, count: results.filter(({ type }) => type === value).length }))
  .filter(({ count }) => count > 0);
const countLabel = (count: number) => `${count} ${count === 1 ? 'risultato' : 'risultati'}`;
---

<section class="search-results section-spacing" aria-labelledby="search-results-title" data-search-results>
  <div class="container section-container">
    <h2 id="search-results-title" class="visually-hidden">Risultati della ricerca</h2>
    <form class="library-search d-flex flex-column flex-md-row align-items-md-end gap-3" action="/cerca/" method="get" role="search" aria-label="Cerca nel sito">
      <div class="flex-grow-1">
        <label class="form-label" for="search-results-query">Cerca per titolo o per parola chiave</label>
        <div class="library-query">
          <img src="/assets/icone/ricerca.svg" width="14" height="14" alt="" />
          <input id="search-results-query" class="form-control" name="q" type="search" value={query} placeholder="Cerca nel sito…" enterkeyhint="search" />
        </div>
      </div>
      <div>
        <button class="btn site-button site-button--blue site-button--small library-submit justify-content-center" type="submit">Cerca <img src="/assets/icone/ricerca.svg" width="14" height="14" alt="" /></button>
      </div>
    </form>

    {results.length > 0 && (
      <Fragment>
        {filters.length > 1 && (
          <div class="search-results-filters d-flex flex-wrap gap-2" role="group" aria-label="Filtra per tipo">
            <button class="content-filter content-filter--compact" type="button" data-search-filter="" aria-pressed="true">Tutti ({results.length})</button>
            {filters.map(({ value, label, count }) => <button class="content-filter content-filter--compact" type="button" data-search-filter={value} aria-pressed="false">{label} ({count})</button>)}
          </div>
        )}
        <p class="library-count" role="status" data-search-count>{countLabel(results.length)}</p>
        <ol class="search-results-list list-unstyled mb-0">
          {results.map(({ type, title, href, excerpt, category, dateTime }) => (
            <li class="search-result" data-search-result data-search-type={type}>
              <p class="search-result-meta">
                <span>{searchResultTypes[type].label}</span>
                {category && <span>{category}</span>}
                {dateTime && <time datetime={dateTime}>{dateFormat.format(new Date(dateTime))}</time>}
              </p>
              <h3 class="search-result-title">
                {href ? <a class="site-title-link" href={href}><SearchHighlight text={title} query={query} /></a> : <SearchHighlight text={title} query={query} />}
              </h3>
              {excerpt && <p class="search-result-excerpt mb-0"><SearchHighlight text={excerpt} query={query} /></p>}
            </li>
          ))}
        </ol>
        <div class="library-more text-center d-none" data-search-more-wrapper><button class="btn site-button" type="button" data-search-more>Carica altri risultati <span aria-hidden="true">↓</span></button></div>
      </Fragment>
    )}
    {query && results.length === 0 && (
      <Fragment>
        <p class="library-count">Nessun risultato</p>
        <p class="mb-0">Controlli l’ortografia o provi con un termine più generico.</p>
      </Fragment>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-search-results]').forEach((section) => {
    const buttons = section.querySelectorAll<HTMLButtonElement>('[data-search-filter]');
    const items = [...section.querySelectorAll<HTMLElement>('[data-search-result]')];
    const count = section.querySelector<HTMLElement>('[data-search-count]');
    const moreWrapper = section.querySelector<HTMLElement>('[data-search-more-wrapper]');
    const more = section.querySelector<HTMLButtonElement>('[data-search-more]');
    const pageSize = 10;
    let type = '';
    let limit = pageSize;

    const matching = () => items.filter((item) => !type || item.dataset.searchType === type);
    const render = () => {
      const visible = matching();
      items.forEach((item) => item.classList.add('d-none'));
      visible.forEach((item, index) => item.classList.toggle('d-none', index >= limit));
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.searchFilter === type)));
      if (count) count.textContent = `${visible.length} ${visible.length === 1 ? 'risultato' : 'risultati'}`;
      moreWrapper?.classList.toggle('d-none', visible.length <= limit);
    };

    buttons.forEach((button) => button.addEventListener('click', () => {
      type = button.dataset.searchFilter ?? '';
      limit = pageSize;
      render();
    }));
    more?.addEventListener('click', () => {
      const next = matching()[limit]?.querySelector<HTMLElement>('.search-result-title');
      limit += pageSize;
      render();
      next?.setAttribute('tabindex', '-1');
      next?.focus();
    });
    render();
  });
</script>
