---
import Layout from '../Layout.astro';
import customLabel from '../../lib/utility-customlabel';
import customSlug from '../../lib/utility-customslug';
import { getLangFromUrl } from '../../lib/lang-switch/route-map';
import '../../styles/pages/thank-you.scss';

interface Props {
  title: string;
}

const { title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<Layout lang={lang}>
  <section class="thank-you section-spacing text-center" aria-labelledby="thanks-title">
    <div class="container section-container">
      <div class="row justify-content-center">
        <div class="col-lg-10 col-xxl-9">
          <h1 id="thanks-title" class="type-section-title mb-4">{title}</h1>
          <div class="row justify-content-center">
            <div class="col-lg-10">
              <p class="type-section-lead type-section-lead--relaxed mb-4"><slot /></p>
            </div>
          </div>
          <a class="btn site-button" href={customSlug('home', lang)}>{customLabel('Torna alla homepage', lang)} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>
