---
import type { Articolo } from '../../lib/articoli';
import Layout from '../Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import ArticleAuthor from '../ArticleAuthor.astro';
import EditorialContactCard from '../EditorialContactCard.astro';
import ContentShare from '../ContentShare.astro';
import FaqSection from '../FaqSection.astro';
import DocumentList from '../DocumentList.astro';
import RelatedContent from '../RelatedContent.astro';
import CallToAction from '../CallToAction.astro';
import '../../styles/pages/articolo.scss';
import '../../styles/components/editorial-prose.scss';

import customLabel from '../../lib/utility-customlabel';
import { localizeHref, type Locale } from '../../lib/lang-switch/route-map';

interface Props extends Articolo {
  lang?: Locale;
}

const { lang = 'it', article, sections: contentSections, faqItems, documents, relatedArticles, seo, publishedAt, categories } = Astro.props;
const pageUrl = new URL(article.href, (Astro.site ?? Astro.url).origin).href;
const authorName = [article.author?.firstName, article.author?.lastName].filter(Boolean).join(' ');
const articleJsonLd = {
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  headline: article.title,
  description: article.excerpt || undefined,
  image: article.image?.src,
  datePublished: publishedAt,
  inLanguage: lang,
  articleSection: categories.length ? categories : undefined,
  author: authorName ? { '@type': 'Person', name: authorName, jobTitle: article.author?.role } : { '@id': `${(Astro.site ?? Astro.url).origin}/#organization` },
  publisher: { '@id': `${(Astro.site ?? Astro.url).origin}/#organization` },
};
const indexSections = [
  ...contentSections.filter((section) => section.id),
  ...(faqItems.length > 0 ? [{ id: 'faq-articolo', title: customLabel('Domande frequenti', lang) }] : []),
];

const consultation = { title: 'Il tuo trust è conforme alla nuova normativa?', description: 'I nostri esperti possono analizzare la tua struttura e guidarti nell’adeguamento.' };
---

<Layout lang={lang} title={article.title} description={article.excerpt} seo={seo} jsonLd={[articleJsonLd]} article={{ publishedTime: publishedAt, authors: authorName ? [authorName] : undefined, section: article.category || undefined }}>
  <div class="article-page" data-article>
    <header class="article-hero">
      <div class="container frame-container">
        <Breadcrumb current={article.category || article.title} parents={[{ label: 'AG Informa', href: localizeHref('/ag-informa/', lang)! }]} light />
        <div class="row gx-5 gy-4 align-items-center article-hero-layout">
          <div class="col-lg">
            {article.category && <p class="article-category">{article.category}</p>}
            <h1 id="page-title" class="article-title">{article.title}</h1>
            <p class="article-introduction">{article.excerpt}</p>
            <div class="article-meta d-flex flex-wrap align-items-center">
              {article.author && <ArticleAuthor author={article.author} compact />}
              <p class="mb-0">{customLabel('Pubblicato il', lang)} <time datetime={article.dateTime}>{article.date}</time></p>
              {article.readingTime && <p class="mb-0">{article.readingTime}</p>}
            </div>
          </div>
          {article.image && <div class="col-lg-auto article-hero-media"><img class="d-block w-100 h-auto" src={article.image.src} alt={article.image.alt} width={article.image.width} height={article.image.height} /></div>}
        </div>
      </div>
    </header>

    <div class="article-main section-spacing">
      <div class="container frame-container frame-container--editorial">
        <div class="row gx-lg-5 gy-5">
          <aside class="col-lg-4 col-xl-3 order-lg-2 article-sidebar" aria-label={customLabel('Strumenti dell’articolo', lang)}>
            {indexSections.length > 0 && <nav class="article-index article-sidebar-box" aria-label={customLabel('Indice dell’articolo', lang)}>
              <p class="article-sidebar-label d-none d-lg-block">{customLabel('Indice', lang)}</p>
              <button class="article-index-toggle d-flex d-lg-none align-items-center justify-content-between w-100 collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#article-index-panel" aria-expanded="false" aria-controls="article-index-panel">{customLabel('Indice dell’articolo', lang)} <span class="collapse-toggle" aria-hidden="true"></span></button>
              <div id="article-index-panel" class="collapse d-lg-block">
                <div id="article-index-links" class="nav flex-column">
                  {indexSections.map(({ id, title }) => <a class="nav-link" href={`#${id}`}>{title}</a>)}
                </div>
              </div>
            </nav>}
            <ContentShare title={article.title} />
            <div class="d-none d-lg-block"><EditorialContactCard {...consultation} /></div>
          </aside>

          <div class="col-lg-8 col-xl-9 order-lg-1 article-content">
            <article class="editorial-prose" aria-label={article.title}>
              {contentSections.map(({ id, title, html }) => (
                <section id={id} aria-labelledby={id && `${id}-title`}>
                  {title && <h2 id={`${id}-title`}>{title}</h2>}
                  <Fragment set:html={html} />
                </section>
              ))}
            </article>

            {faqItems.length > 0 && <FaqSection id="faq-articolo" items={faqItems} embedded><Fragment slot="title">{customLabel('Domande frequenti', lang)}</Fragment></FaqSection>}

            {documents.length > 0 && <section class="editorial-documents" aria-labelledby="article-documents-title"><h2 id="article-documents-title">{customLabel('Documenti correlati', lang)}</h2><DocumentList documents={documents} compact /></section>}
            {article.editorialNote && <div class="article-editorial-note d-flex align-items-center"><img src="/assets/immagini/articolo/contrassegno-ai.webp" width="81" height="81" alt="" loading="lazy" /><p class="mb-0">{article.editorialNote}</p></div>}
            {article.author && <ArticleAuthor author={article.author} />}
            <div class="article-mobile-contact d-lg-none"><EditorialContactCard {...consultation} /></div>
          </div>
        </div>
      </div>
    </div>

    {relatedArticles.length > 0 && <RelatedContent editorial articles={relatedArticles} eyebrow={customLabel('Continua a leggere', lang)} showLibraryLink={false}>
      <a slot="articles-action" class="site-text-link" href={localizeHref('/ag-informa/', lang)}>{customLabel('Tutti gli articoli', lang)} <span aria-hidden="true">→</span></a>
    </RelatedContent>}

    <CallToAction contained plainBackground eyebrow="AG Trustees" href={localizeHref('/contatti/', lang)} label={customLabel('Richiedi un confronto', lang)} secondaryAction={{ label: customLabel('Vai ad AG Informa', lang), href: localizeHref('/ag-informa/', lang) }}>
      <Fragment slot="title">{lang === 'en' ? 'Find out more about this topic' : "Scopri di più sull'argomento"}</Fragment>
      {lang === 'en' ? 'Would you like to explore the topics covered in this article or discuss a specific need?' : 'Desideri approfondire i temi trattati nell’articolo o vuoi confrontarti su una specifica esigenza?'}
    </CallToAction>
  </div>
</Layout>

<script>
  import ScrollSpy from 'bootstrap/js/dist/scrollspy';

  const article = document.querySelector<HTMLElement>('[data-article]');
  const articleIndex = article?.querySelector<HTMLElement>('#article-index-links');
  const readingSection = article?.querySelector<HTMLElement>('.editorial-prose section[id], #faq-articolo');
  if (articleIndex && readingSection) {
    const readingLine = parseFloat(getComputedStyle(readingSection).scrollMarginTop);
    const readingBand = 48;
    const createIndexSpy = () => new ScrollSpy(document.body, {
      target: articleIndex,
      rootMargin: `-${readingLine}px 0px -${Math.max(0, window.innerHeight - readingLine - readingBand)}px`,
      threshold: [0],
    });
    let indexSpy = createIndexSpy();
    window.addEventListener('resize', () => {
      indexSpy.dispose();
      indexSpy = createIndexSpy();
    });
  }
</script>
