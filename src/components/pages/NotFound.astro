---
import { getLangFromUrl, localizeHref } from '../../lib/lang-switch/route-map';
import Layout from '../Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import '../../styles/pages/not-found.scss';

const lang = getLangFromUrl(Astro.url);

const links = [
  { label: lang === 'en' ? 'Discover AG Trustees' : 'Scopri AG Trustees', href: '/chi-siamo/' },
  { label: lang === 'en' ? 'Explore our services' : 'Esplora i servizi', href: '/servizi/' },
  { label: lang === 'en' ? 'Explore AG Informa' : 'Consulta AG Informa', href: '/ag-informa/' },
  { label: lang === 'en' ? 'Visit the Knowledge Library' : 'Accedi alla Knowledge Library', href: '/knowledge-library/' },
  { label: lang === 'en' ? 'Contact us' : 'Contattaci', href: '/contatti/' },
];
const columnLength = Math.ceil(links.length / 2);
const columns = [links.slice(0, columnLength), links.slice(columnLength)];
---

<Layout lang={lang}>
  <section class="not-found" aria-labelledby="page-title">
    <div class="container section-container not-found-container">
      <Breadcrumb current="404" />
      <div class="not-found-content">
        <p class="type-eyebrow not-found-eyebrow">{lang === 'en' ? '404 – Page Not Found' : 'Errore 404 · Pagina non trovata'}</p>
        <h1 id="page-title" class="not-found-title">{lang === 'en' ? <Fragment>Let's find <span class="type-section-title-accent">a new direction</span></Fragment> : <Fragment>Troviamo<br /> <span class="type-section-title-accent">una nuova direzione.</span></Fragment>}</h1>
        <p class="type-section-lead not-found-copy mb-0">{lang === 'en' ? "The page you're looking for may have been moved or updated. You can return to the homepage, browse the latest insights from AG Informa or try a new search." : <Fragment><span class="d-xl-block">Il contenuto che stai cercando potrebbe essere stato spostato oppure aggiornato.</span>{' '}Puoi tornare alla homepage, consultare gli approfondimenti di AG Informa o effettuare una nuova ricerca.</Fragment>}</p>
        <a class="btn site-button not-found-home" href={localizeHref("/", lang)}>{lang === 'en' ? 'Back to Homepage' : 'Torna alla homepage'} <span aria-hidden="true">→</span></a>

        <nav class="not-found-explore" aria-labelledby="not-found-explore-title">
          <h2 id="not-found-explore-title">{lang === 'en' ? 'Or continue exploring:' : 'Oppure continua a esplorare:'}</h2>
          <div class="row gx-5">
            {columns.map((column, columnIndex) => (
              <div class="col-md-6">
                <ol class="list-unstyled mb-0" start={columnIndex * columnLength + 1}>
                  {column.map(({ label, href }, index) => (
                    <li>
                      <a class="not-found-link" href={localizeHref(href, lang)}>
                        <span class="not-found-index" aria-hidden="true">{String(columnIndex * columnLength + index + 1).padStart(2, '0')}</span>
                        <span>{label}</span>
                        <span class="ms-auto" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </nav>
      </div>
    </div>
  </section>
</Layout>
