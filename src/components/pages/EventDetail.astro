---
import type { Evento } from '../../lib/eventi';
import calendarIcon from 'bootstrap-icons/icons/calendar3.svg?raw';
import clockIcon from 'bootstrap-icons/icons/clock.svg?raw';
import locationIcon from 'bootstrap-icons/icons/geo-alt.svg?raw';
import Layout from '../Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import EventDate from '../EventDate.astro';
import ContentShare from '../ContentShare.astro';
import EditorialContactCard from '../EditorialContactCard.astro';
import DocumentList from '../DocumentList.astro';
import EventList from '../EventList.astro';
import CallToAction from '../CallToAction.astro';
import '../../styles/components/editorial-prose.scss';
import '../../styles/pages/evento.scss';

import customLabel from '../../lib/utility-customlabel';
import { localizeHref, type Locale } from '../../lib/lang-switch/route-map';

interface Props extends Evento {
  lang?: Locale;
}

const { lang = 'it', event, content, documents, relatedEvents, languageUrls, seo } = Astro.props;
const origin = (Astro.site ?? Astro.url).origin;
const pageUrl = new URL(event.href, origin).href;
const online = event.formatTone === 'webinar';
const eventJsonLd = {
  '@type': 'Event',
  '@id': `${pageUrl}#event`,
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  name: event.title,
  description: event.description || undefined,
  image: event.cover?.src,
  startDate: event.time && event.date.dateTime ? `${event.date.dateTime}T${event.time}` : event.date.dateTime,
  endDate: event.date.endDateTime,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: online ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
  location: online ? { '@type': 'VirtualLocation', url: pageUrl } : event.location ? { '@type': 'Place', name: event.location, address: event.location } : undefined,
  organizer: { '@id': `${origin}/#organization` },
  inLanguage: lang,
};
const dateLabel = event.date.label ?? `${event.date.days} ${event.date.month} ${event.date.year}`;
const facts = [
  { label: customLabel('Data', lang), value: dateLabel, icon: calendarIcon, dateTime: event.date.dateTime },
  ...(event.time ? [{ label: customLabel('Orario', lang), value: event.time, icon: clockIcon, dateTime: event.time }] : []),
  { label: customLabel('Luogo', lang), value: event.location, icon: locationIcon },
];
const consultation = { eyebrow: 'Contatti', title: 'Lorem ipsum dolor sit amet?', description: 'I nostri esperti possono analizzare la tua struttura e guidarti nell’adeguamento.' };
---

<Layout lang={lang} title={event.title} description={event.description} seo={seo} languageUrls={languageUrls} jsonLd={[eventJsonLd]}>
  <div class="event-detail-page">
    <header class="event-detail-hero">
      <div class="container frame-container">
        <Breadcrumb current={event.category ?? event.format ?? customLabel('Evento', lang)} parents={[{ label: 'AG Informa', href: localizeHref('/ag-informa/', lang)! }, { label: customLabel('Eventi', lang), href: localizeHref('/eventi-in-agenda/', lang)! }]} />
        <div class="event-detail-heading">
          <EventDate date={event.date} variant="hero" />
          <div class="event-detail-meta d-flex flex-wrap align-items-center">
            {(event.category || event.format) && <span class="event-detail-category">{event.category ?? event.format}</span>}
            <span class="d-inline-flex align-items-center gap-1"><span class="event-detail-pin d-inline-flex" aria-hidden="true" set:html={locationIcon} />{event.location}</span>
          </div>
          <h1 id="page-title" class="event-detail-title mb-0">{event.title}</h1>
        </div>
        {event.cover && <img class="event-detail-cover d-block w-100 h-auto" src={event.cover.src} alt={event.cover.alt} width={event.cover.width} height={event.cover.height} />}
      </div>
    </header>

    <div class="event-detail-main section-spacing">
      <div class="container frame-container">
        <div class="row gx-lg-5 gy-5">
          <aside class="col-lg-3 order-lg-2" aria-label={customLabel('Informazioni e condivisione dell’evento', lang)}>
            <dl class="event-detail-facts mb-0">
              {facts.map(({ label, value, icon, ...fact }) => <div class="event-detail-fact">
                <dt class="d-flex align-items-center"><span class="event-detail-fact-icon d-inline-flex" aria-hidden="true" set:html={icon} />{label}</dt>
                <dd class="mb-0">{'dateTime' in fact && fact.dateTime ? <time datetime={fact.dateTime}>{value}</time> : value}</dd>
              </div>)}
            </dl>
            <ContentShare title={event.title} />
            <div class="d-none d-lg-block"><EditorialContactCard {...consultation} /></div>
          </aside>
          <div class="col-lg-9 order-lg-1">
            <article class="editorial-prose" aria-label={event.title} set:html={content} />
            {documents.length > 0 && <section class="editorial-documents" aria-labelledby="event-documents-title"><h2 id="event-documents-title">{customLabel('Documenti correlati', lang)}</h2><DocumentList documents={documents} compact /></section>}
            <div class="event-detail-mobile-contact d-lg-none"><EditorialContactCard {...consultation} /></div>
          </div>
        </div>
      </div>
    </div>

    <EventList id="eventi-correlati" title={customLabel('Potrebbero interessarti', lang)} eyebrow={customLabel('In agenda', lang)} events={relatedEvents} compact compactTitle={false} />

    <CallToAction eyebrow={customLabel('AG Trustees — Esperti in Trust e Pianificazione patrimoniale', lang)} href={localizeHref('/contatti/', lang)} label={customLabel('Parliamone', lang)}>
      <Fragment slot="title">{lang === 'en' ? customLabel('Dare continuità al valore richiede una visione chiara', lang) : <Fragment>Dare continuità al valore<br class="d-none d-xl-block" />{' '}richiede una visione chiara</Fragment>}</Fragment>
      {customLabel('Ogni progetto patrimoniale nasce da una storia diversa. Comprenderla è il primo passo per costruire regole coerenti con le persone, gli obiettivi e il futuro.', lang)}
    </CallToAction>
  </div>
</Layout>
