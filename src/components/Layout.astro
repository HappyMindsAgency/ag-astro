---
import Head from './Head.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import customLabel from '../lib/utility-customlabel';
import { getLangFromUrl, type Locale } from '../lib/lang-switch/route-map';

import '../styles/globals.scss';

interface Props {
    lang?: Locale;
    title?: string;
    description?: string;
    linkedinUrl?: string;
    headerHeroId?: string;
}

const { lang = getLangFromUrl(Astro.url), title = 'AG Trustees', description, linkedinUrl, headerHeroId } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
    <Head title={title} description={description} />
    <body>
        <a class="skip-link visually-hidden-focusable" href="#contenuto-principale">{customLabel('Vai al contenuto', lang)}</a>
        <Navbar lang={lang} linkedinUrl={linkedinUrl} heroId={headerHeroId} />
        <main id="contenuto-principale" tabindex="-1">
            <slot />
        </main>
        <Footer lang={lang} linkedinUrl={linkedinUrl} />
    </body>
</html>

