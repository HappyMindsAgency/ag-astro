---
import Head from '../components/Head.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/globals.scss';


interface Props {
    lang?: string;
    title?: string;
    description?: string;
    linkedinUrl?: string;
    headerHeroId?: string;
}

const { lang = 'it', title = 'AG Trustees', description, linkedinUrl, headerHeroId } = Astro.props;

---
<!DOCTYPE html>
<html lang={lang}>
    <Head title={title} description={description} />
    <body>
        <a class="skip-link visually-hidden-focusable" href="#contenuto-principale">Vai al contenuto</a>
        <Navbar linkedinUrl={linkedinUrl} heroId={headerHeroId} />
        <main id="contenuto-principale" tabindex="-1">
            <slot />
        </main>
        <Footer linkedinUrl={linkedinUrl} />
    </body>

    <script>
        import 'bootstrap/js/dist/collapse';
    </script>
</html>

