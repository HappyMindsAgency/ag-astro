---
import '../styles/components/faq-section.scss';

interface Props {
  id: string;
  items: { question: string; answer: string }[];
  largeTitle?: boolean;
  twoColumns?: boolean;
  embedded?: boolean;
}

const { id, items, largeTitle = false, twoColumns = false, embedded = false } = Astro.props;
const half = Math.ceil(items.length / 2);
const columns = twoColumns ? [items.slice(0, half), items.slice(half)] : [items];
const listId = `${id}-list`;
---

<section id={id} class:list={['faq-section', { 'section-spacing': !embedded, 'faq-section--large-title': largeTitle, 'faq-section--two-columns': twoColumns, 'faq-section--embedded': embedded }]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="row gx-4 gy-4">
      <div class={twoColumns || embedded ? 'col-12' : 'col-lg-6'}>
        {!embedded && <p class="type-eyebrow type-eyebrow--section faq-eyebrow">FAQ</p>}
        <h2 id={`${id}-title`} class:list={['mb-0', embedded ? 'faq-embedded-title' : 'type-section-title type-section-title--compact faq-title']}><slot name="title" /></h2>
      </div>
      <div class={twoColumns || embedded ? 'col-12' : 'col-lg-6'}>
        <div id={listId} class:list={['accordion faq-list', { 'row g-0': twoColumns }]}>
          {columns.map((column, columnIndex) => (
            <div class:list={{ 'col-lg-6': twoColumns, 'pe-lg-4': twoColumns && columnIndex === 0, 'ps-lg-4': twoColumns && columnIndex === 1 }}>
              <div class="faq-list-column">
                {column.map(({ question, answer }, itemIndex) => {
                  const index = columnIndex * half + itemIndex;
                  const questionId = `${id}-question-${index}`;
                  const answerId = `${id}-answer-${index}`;

                  return (
                    <div class="accordion-item">
                      <h3 class="accordion-header">
                        <button
                          id={questionId}
                          class="accordion-button collapsed faq-question"
                          type="button"
                          data-bs-toggle="collapse"
                          data-bs-target={`#${answerId}`}
                          aria-expanded="false"
                          aria-controls={answerId}
                        >
                          <span>{question}</span>
                          <span class="collapse-toggle ms-auto" aria-hidden="true"></span>
                        </button>
                      </h3>
                      <div id={answerId} class="accordion-collapse collapse" aria-labelledby={questionId} data-bs-parent={`#${listId}`}>
                        <div class="accordion-body faq-answer"><p class="mb-0">{answer}</p></div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
