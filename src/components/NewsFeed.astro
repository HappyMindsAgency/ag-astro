---
import type { ArticlePreview } from '../types/content';
import '../styles/components/news-feed.scss';

interface Props {
  articles?: ArticlePreview[];
}

const { articles = [] } = Astro.props;
const categories = [...new Set(articles.map(({ category }) => category))];
const filters = [
  { value: 'all', label: 'Tutte' },
  ...(articles.some(({ featured }) => featured) ? [{ value: 'featured', label: 'In evidenza' }] : []),
  ...categories.map((category) => ({ value: `category:${category}`, label: category })),
];
const mainArticles = articles.slice(0, 2);
const otherArticles = articles.slice(2);
---

{articles.length > 0 && (
  <section class="news-feed section-spacing" aria-labelledby="news-feed-title" data-news-feed>
    <div class="container">
      <div class="d-flex flex-wrap justify-content-between align-items-end news-feed-header">
        <div>
          <p class="type-eyebrow type-eyebrow--section news-feed-eyebrow">Conoscenza condivisa</p>
          <h2 id="news-feed-title" class="type-section-title mb-0">AG Informa</h2>
        </div>
        <a class="site-text-link" href="/ag-informa/">Vai ad AG Informa <span aria-hidden="true">→</span></a>
      </div>
      <div class="d-flex flex-wrap news-feed-filters" role="group" aria-label="Filtra gli articoli">
        {filters.map(({ value, label }, index) => (
          <button class="news-feed-filter" type="button" data-news-filter={value} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>
        ))}
      </div>
      <div class="row news-feed-layout">
        <div class={otherArticles.length > 0 ? 'col-xl-7' : 'col-12'} data-news-group>
          {mainArticles.map(({ title, href, image, category, date, dateTime, excerpt, featured }) => (
            <article class:list={['news-main-article', { 'news-main-article--featured': featured }]} data-news-article data-news-category={category} data-news-featured={featured ? 'true' : 'false'}>
              <div class="row gx-4 gy-4">
                <div class="col-md-4">
                  <a href={href} tabindex="-1" aria-hidden="true"><img class="news-main-image" src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" /></a>
                </div>
                <div class="col-md-8">
                  <p class="news-article-meta"><span class:list={{ 'news-article-category--featured': featured }}>{featured ? 'In evidenza' : category}</span><time datetime={dateTime}>{date}</time></p>
                  <h3 class="news-main-title"><a href={href}>{title}</a></h3>
                  <p class="news-main-excerpt">{excerpt}</p>
                  <a class="news-read-more" href={href} aria-label={`Leggi: ${title}`}>Leggi <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>
        {otherArticles.length > 0 && (
          <div class="col-xl-5" data-news-group>
            <h3 class="news-other-heading">Altri articoli</h3>
            <ul class="list-unstyled mb-0">
              {otherArticles.map(({ title, href, category, date, dateTime, featured }) => (
                <li class:list={['news-other-article', { 'news-other-article--featured': featured }]} data-news-article data-news-category={category} data-news-featured={featured ? 'true' : 'false'}>
                  <div class="news-other-content">
                    <p class="news-article-meta"><span class:list={{ 'news-article-category--featured': featured }}>{category}</span><time datetime={dateTime}>{date}</time></p>
                    <h4 class="news-other-title mb-0"><a href={href}>{title}</a></h4>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-news-feed]').forEach((feed) => {
    const buttons = feed.querySelectorAll<HTMLButtonElement>('[data-news-filter]');
    const articles = feed.querySelectorAll<HTMLElement>('[data-news-article]');
    const groups = feed.querySelectorAll<HTMLElement>('[data-news-group]');
    const layout = feed.querySelector<HTMLElement>('.news-feed-layout');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.newsFilter;

        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        articles.forEach((article) => {
          const visible = filter === 'all'
            || (filter === 'featured' && article.dataset.newsFeatured === 'true')
            || filter === `category:${article.dataset.newsCategory}`;
          article.classList.toggle('d-none', !visible);
        });
        groups.forEach((group) => {
          const visible = group.querySelector('[data-news-article]:not(.d-none)') !== null;
          group.classList.toggle('d-none', !visible);
        });
        layout?.classList.toggle('news-feed-layout--single', [...groups].filter((group) => !group.classList.contains('d-none')).length === 1);
      });
    });
  });
</script>
