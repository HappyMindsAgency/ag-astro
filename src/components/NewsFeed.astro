---
import type { ArticlePreview } from '../types/content';
import NewsArticleCard from './NewsArticleCard.astro';
import '../styles/components/content-filter.scss';
import '../styles/components/news-feed.scss';

interface Props {
  articles?: ArticlePreview[];
  archive?: boolean;
  eyebrow?: string;
  categories?: string[];
}

const { articles = [], archive = false, eyebrow = 'Conoscenza condivisa', categories = [...new Set(articles.map(({ category }) => category))] } = Astro.props;
const filters = [
  { value: 'all', label: 'Tutte' },
  ...(articles.some(({ featured }) => featured) ? [{ value: 'featured', label: 'In evidenza' }] : []),
  ...categories.map((category) => ({ value: `category:${category}`, label: category })),
];
const mainArticles = archive ? articles : articles.slice(0, 2);
const otherArticles = archive ? [] : articles.slice(2);
---

{articles.length > 0 && (
  <section id={archive ? 'notizie' : undefined} class:list={['news-feed section-spacing', { 'news-feed--archive': archive }]} aria-labelledby="news-feed-title" data-news-feed data-news-paginated={archive ? '' : undefined}>
    <div class="container section-container">
      <div class="d-flex flex-wrap justify-content-between align-items-end news-feed-header">
        <div>
          {!archive && <p class="type-eyebrow type-eyebrow--section news-feed-eyebrow">{eyebrow}</p>}
          <h2 id="news-feed-title" class:list={['mb-0', archive ? 'type-editorial-list-title' : 'type-section-title']}>{archive ? 'Notizie' : 'AG Informa'}</h2>
        </div>
        {archive
          ? <button class="site-text-link news-feed-reset" type="button" data-news-reset>Tutti gli articoli <span aria-hidden="true">→</span></button>
          : <a class="site-text-link" href="/ag-informa/">Vai ad AG Informa <span aria-hidden="true">→</span></a>}
      </div>
      <div class="d-flex flex-wrap news-feed-filters" role="group" aria-label="Filtra gli articoli">
        {filters.map(({ value, label }, index) => (
          <button class="content-filter" type="button" data-news-filter={value} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>
        ))}
      </div>
      <div class="row news-feed-layout">
        <div class={otherArticles.length > 0 ? 'col-xl-7' : 'col-12'} data-news-group>
          {archive ? (
            <div class="row gx-4 gy-4">
              {mainArticles.map((article) => <div class="col-md-6" data-news-item><NewsArticleCard article={article} variant="compact" /></div>)}
            </div>
          ) : mainArticles.map((article) => <NewsArticleCard article={article} />)}
        </div>
        {otherArticles.length > 0 && (
          <div class="col-xl-5" data-news-group>
            <h3 class="news-other-heading">Altri articoli</h3>
            <ul class="list-unstyled mb-0">
              {otherArticles.map(({ title, href, category, date, dateTime, featured }) => (
                <li class:list={['news-other-article', { 'news-other-article--featured': featured }]} data-news-article data-news-category={category} data-news-featured={featured ? 'true' : 'false'}>
                  <div class="news-other-content">
                    <p class="news-article-meta"><span class:list={{ 'news-article-category--featured': featured }}>{category}</span><time datetime={dateTime}>{date}</time></p>
                    <h4 class="news-other-title mb-0"><a href={href}>{title}</a></h4>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      {archive && <div class="news-feed-more text-center"><button class="btn site-button" type="button" data-news-more>Carica altri articoli <span aria-hidden="true">↓</span></button></div>}
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-news-feed]').forEach((feed) => {
    const buttons = feed.querySelectorAll<HTMLButtonElement>('[data-news-filter]');
    const articles = feed.querySelectorAll<HTMLElement>('[data-news-article]');
    const groups = feed.querySelectorAll<HTMLElement>('[data-news-group]');
    const layout = feed.querySelector<HTMLElement>('.news-feed-layout');
    const more = feed.querySelector<HTMLButtonElement>('[data-news-more]');
    const reset = feed.querySelector<HTMLButtonElement>('[data-news-reset]');
    const paginated = feed.hasAttribute('data-news-paginated');
    const desktop = window.matchMedia(`(min-width: ${getComputedStyle(document.documentElement).getPropertyValue('--bs-breakpoint-lg')})`);
    const pageSize = () => desktop.matches ? 8 : 4;
    let activeFilter = 'all';
    let visibleLimit = pageSize();

    const render = () => {
      let matches = 0;
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.newsFilter === activeFilter)));
      articles.forEach((article) => {
        const matched = activeFilter === 'all'
          || (activeFilter === 'featured' && article.dataset.newsFeatured === 'true')
          || activeFilter === `category:${article.dataset.newsCategory}`;
        const visible = matched && (!paginated || ++matches <= visibleLimit);
        article.classList.toggle('d-none', !visible);
        article.closest<HTMLElement>('[data-news-item]')?.classList.toggle('d-none', !visible);
      });
      groups.forEach((group) => group.classList.toggle('d-none', group.querySelector('[data-news-article]:not(.d-none)') === null));
      layout?.classList.toggle('news-feed-layout--single', [...groups].filter((group) => !group.classList.contains('d-none')).length === 1);
      more?.classList.toggle('d-none', matches <= visibleLimit);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.newsFilter ?? 'all';
        visibleLimit = pageSize();
        render();
      });
    });
    more?.addEventListener('click', () => {
      const previouslyVisible = new Set([...articles].filter((article) => !article.classList.contains('d-none')));
      visibleLimit += pageSize();
      render();
      [...articles].find((article) => !article.classList.contains('d-none') && !previouslyVisible.has(article))?.querySelector<HTMLAnchorElement>('.news-main-title a')?.focus();
    });
    reset?.addEventListener('click', () => { activeFilter = 'all'; visibleLimit = pageSize(); render(); });
    if (paginated) desktop.addEventListener('change', () => { visibleLimit = pageSize(); render(); });
    render();
  });
</script>
