---
import '../styles/components/page-intro.scss';

interface Props {
  breadcrumb: string;
  parents?: { label: string; href: string }[];
  eyebrow: string;
  mobileTitleLeading?: 'tight' | 'regular' | 'relaxed';
  wideTitle?: boolean;
  fitMobileTitle?: boolean;
}

const { breadcrumb, parents = [], eyebrow, mobileTitleLeading = 'regular', wideTitle = false, fitMobileTitle = wideTitle } = Astro.props;
const headingColumnClass = wideTitle ? 'col-md-6 col-xxl' : 'col-md-6';
const copyColumnClass = wideTitle ? 'col-md-6 col-xxl-auto' : 'col-md-6';
---

<section class:list={['page-intro', { 'page-intro--wide-title': wideTitle, 'page-intro--fit-mobile-title': fitMobileTitle }]} aria-labelledby="page-title">
  <div class="container">
    <nav aria-label="Percorso di navigazione">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        {parents.map(({ label, href }) => <li class="breadcrumb-item"><a href={href}>{label}</a></li>)}
        <li class="breadcrumb-item active" aria-current="page">{breadcrumb}</li>
      </ol>
    </nav>

    <div class="row align-items-end">
      <div class:list={[headingColumnClass, 'page-intro-heading']}>
        <p class="type-eyebrow page-intro-eyebrow">{eyebrow}</p>
        <h1 id="page-title" class:list={['type-page-title mb-0', {
          'type-page-title--tight': mobileTitleLeading === 'tight',
          'type-page-title--relaxed': mobileTitleLeading === 'relaxed',
        }]}>
          <slot name="title" />
        </h1>
      </div>
      <div class:list={[copyColumnClass, 'page-intro-copy-column']}>
        <p class="type-page-lead page-intro-copy mb-0"><slot /></p>
      </div>
    </div>
  </div>
</section>
