---
import customLabel from '../lib/utility-customlabel';
import { getLangFromUrl, localizeHref } from '../lib/lang-switch/route-map';
import type { EventPreview } from '../types/content';
import customSlug from '../lib/utility-customslug';
import EventCard from './EventCard.astro';
import '../styles/components/event-list.scss';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  events?: EventPreview[];
  compact?: boolean;
  compactTitle?: boolean;
  calendarHref?: string;
}

const { id, title, eyebrow, events = [], compact = false, compactTitle = compact, calendarHref } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = (label: string) => customLabel(label, lang);
const calendarUrl = calendarHref ?? customSlug('eventCalendar', lang);
---

{events.length > 0 && <section id={id} class:list={['event-list section-spacing', { 'event-list--compact': compact }]} aria-labelledby={`${id}-title`}>
  <div class="container frame-container">
    <div class="event-list-header d-flex flex-wrap justify-content-between align-items-end">
      <div>
        {eyebrow && <p class="type-eyebrow type-eyebrow--section event-list-eyebrow">{t(eyebrow)}</p>}
        <h2 id={`${id}-title`} class:list={['type-editorial-list-title mb-0', { 'type-editorial-list-title--compact': compactTitle }]}>{title}</h2>
      </div>
      <a class="site-text-link" href={localizeHref(calendarUrl, lang)}>{t('Calendario completo')} <span aria-hidden="true">→</span></a>
    </div>
    <div class="row gx-4 gy-5">
      {events.map(event => <div class="col-md-6 col-xl-4"><EventCard event={event} compact={compact} /></div>)}
    </div>
  </div>
</section>}
