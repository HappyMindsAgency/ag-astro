---
import '../styles/components/editorial-contact-card.scss';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = 'Consulenza' } = Astro.props;
---

<div class="editorial-contact-card">
  <p class="editorial-contact-label">{eyebrow}</p>
  <h2>{title}</h2>
  <p>{description}</p>
  <a class="btn site-button site-button--light site-button--small" href="/contatti/">Contattaci <span aria-hidden="true">→</span></a>
</div>
